<script
  src="{{ 'marquee.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- assign logo_opacity_val = section.settings.logo_opacity | divided_by: 100.0 -%}

<style>
  #shopify-section-{{ section.id }} {
    --pm-border-color: {{ section.settings.border_color }};
    --pm-border-width: {{ section.settings.border_width }}px;
    --pm-logo-max-height: {{ section.settings.logo_max_height }}px;
    --pm-logo-opacity: {{ logo_opacity_val }};
    --pm-name-size: {{ section.settings.name_size }}px;
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<marquee-component
  class="section spacing-style color-{{ section.settings.color_scheme }} press-mentions-ticker"
  style="{%- render 'spacing-style', settings: section.settings -%}; {%- render 'gap-style', value: section.settings.gap, name: 'marquee-gap' -%} --marquee-direction: {{ section.settings.movement_direction }};"
  data-speed-factor="{{ section.settings.speed }}"
  data-movement-direction="{{ section.settings.movement_direction }}"
>
  <div class="press-mentions-ticker__wrapper" ref="wrapper">
    <div class="press-mentions-ticker__content" ref="content">
      <div class="press-mentions-ticker__items" ref="marqueeItems[]">
        {%- for block in section.blocks -%}
          <div class="press-mentions-ticker__item" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="press-mentions-ticker__link">{%- endif -%}
              {{-
                block.settings.logo
                | image_url: width: 400
                | image_tag:
                  class: 'press-mentions-ticker__logo',
                  loading: 'lazy',
                  alt: block.settings.publication_name
              -}}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            {%- elsif block.settings.publication_name != blank -%}
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="press-mentions-ticker__link">{%- endif -%}
              <span class="press-mentions-ticker__name">{{ block.settings.publication_name | escape }}</span>
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</marquee-component>

{% stylesheet %}
  .press-mentions-ticker {
    display: block;
    width: 100%;
    overflow: hidden;
    border-top: var(--pm-border-width, 1px) solid var(--pm-border-color, transparent);
    border-bottom: var(--pm-border-width, 1px) solid var(--pm-border-color, transparent);
  }

  .press-mentions-ticker__wrapper {
    display: flex;
    gap: var(--marquee-gap, 60px);
    width: fit-content;
    white-space: nowrap;
  }

  .press-mentions-ticker__content {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap, 60px);
  }

  .press-mentions-ticker__items {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap, 60px);
    align-items: center;
  }

  .press-mentions-ticker__item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .press-mentions-ticker__name {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--pm-name-size, 20px);
    color: var(--color-foreground-heading);
    white-space: nowrap;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .press-mentions-ticker__logo {
    max-height: var(--pm-logo-max-height, 36px);
    width: auto;
    max-width: none;
    object-fit: contain;
    display: block;
    opacity: var(--pm-logo-opacity, 1);
  }

  .press-mentions-ticker__link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    marquee-component:not([data-disabled]) .press-mentions-ticker__wrapper {
      animation: pm-ticker-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }

    @keyframes pm-ticker-motion {
      to {
        transform: translate3d(calc(-50% - (var(--marquee-gap, 60px) / 2)), 0, 0);
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Press mentions",
  "class": "press-mentions-ticker-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#8b1a6b"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Name font size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Logo max height",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 100
    },
    {
      "type": "header",
      "content": "Scroll"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 5,
      "max": 60,
      "step": 5,
      "default": 20
    },
    {
      "type": "select",
      "id": "movement_direction",
      "label": "Scroll direction",
      "options": [
        { "value": "reverse", "label": "Left to right" },
        { "value": "normal", "label": "Right to left" }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-8"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "press-item",
      "name": "Press item",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Publication logo"
        },
        {
          "type": "text",
          "id": "publication_name",
          "label": "Publication name",
          "default": "Publication"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press mentions",
      "blocks": [
        { "type": "press-item", "settings": { "publication_name": "Parents." } },
        { "type": "press-item", "settings": { "publication_name": "EREWHON" } },
        { "type": "press-item", "settings": { "publication_name": "health" } },
        { "type": "press-item", "settings": { "publication_name": "healthline" } },
        { "type": "press-item", "settings": { "publication_name": "Forbes" } },
        { "type": "press-item", "settings": { "publication_name": "Good Housekeeping" } }
      ]
    }
  ]
}
{% endschema %}
