{%- assign logo_opacity_val = section.settings.logo_opacity | divided_by: 100.0 -%}
{%- assign grayscale_filter = 'none' -%}
{%- if section.settings.grayscale -%}
  {%- assign grayscale_filter = 'grayscale(100%)' -%}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} {
    --press-mentions-columns: {{ section.settings.columns }};
    --press-mentions-columns-mobile: {{ section.settings.columns_mobile }};
    --press-mentions-gap: {{ section.settings.gap }}px;
    --press-mentions-logo-max-height: {{ section.settings.logo_max_height }}px;
    --press-mentions-logo-filter: {{ grayscale_filter }};
    --press-mentions-logo-opacity: {{ logo_opacity_val }};
  }
</style>

<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  {%- if section.settings.heading != blank -%}
    <h2
      class="press-mentions__heading"
      style="text-align: {{ section.settings.heading_alignment }};"
    >
      {{ section.settings.heading | escape }}
    </h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="press-mentions__logos">
      {%- for block in section.blocks -%}
        <div class="press-mentions__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a
              class="press-mentions__link"
              href="{{ block.settings.link }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="{{ block.settings.publication_name | escape }}"
            >
          {%- endif -%}

          {%- if block.settings.logo != blank -%}
            {{
              block.settings.logo
              | image_url: width: 400
              | image_tag:
                class: 'press-mentions__logo',
                loading: 'lazy',
                alt: block.settings.publication_name
            }}
          {%- elsif block.settings.publication_name != blank -%}
            <span class="press-mentions__publication-name">{{ block.settings.publication_name | escape }}</span>
          {%- endif -%}

          {%- if section.settings.show_quotes and block.settings.quote != blank -%}
            <p class="press-mentions__quote">{{ block.settings.quote | escape }}</p>
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .press-mentions__heading {
    margin: 0 0 var(--margin-3xl);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: var(--font-h3--size);
    line-height: var(--font-h3--line-height);
    letter-spacing: var(--font-h3--letter-spacing);
    text-transform: var(--font-h3--case);
    color: var(--color-foreground-heading);
  }

  .press-mentions__logos {
    display: grid;
    grid-template-columns: repeat(var(--press-mentions-columns-mobile), 1fr);
    gap: var(--press-mentions-gap, 32px);
    align-items: center;
    justify-items: center;
  }

  .press-mentions__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-sm);
    width: 100%;
  }

  .press-mentions__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-sm);
    text-decoration: none;
    width: 100%;
  }

  .press-mentions__logo {
    max-height: var(--press-mentions-logo-max-height, 48px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    filter: var(--press-mentions-logo-filter, none);
    opacity: var(--press-mentions-logo-opacity, 0.8);
    transition: opacity 0.2s ease, filter 0.2s ease;
  }

  .press-mentions__item:hover .press-mentions__logo {
    opacity: 1;
    filter: none;
  }

  .press-mentions__publication-name {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-h5--size, 1.125rem);
    color: var(--color-foreground-heading);
    text-align: center;
    opacity: var(--press-mentions-logo-opacity, 0.8);
    transition: opacity 0.2s ease;
  }

  .press-mentions__item:hover .press-mentions__publication-name {
    opacity: 1;
  }

  .press-mentions__quote {
    font-family: var(--font-body--family);
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
    color: rgb(var(--color-foreground-rgb) / 0.7);
    text-align: center;
    margin: 0;
    font-style: italic;
  }

  @media screen and (min-width: 750px) {
    .press-mentions__logos {
      grid-template-columns: repeat(var(--press-mentions-columns), 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Press mentions",
  "class": "press-mentions",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Seen In"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_quotes",
      "label": "Show quotes",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Logo max height",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Grayscale logos",
      "default": false
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 80
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "press-item",
      "name": "Press item",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Publication logo"
        },
        {
          "type": "text",
          "id": "publication_name",
          "label": "Publication name",
          "default": "Publication"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press mentions",
      "blocks": [
        {
          "type": "press-item",
          "settings": {
            "publication_name": "Forbes"
          }
        },
        {
          "type": "press-item",
          "settings": {
            "publication_name": "Good Housekeeping"
          }
        },
        {
          "type": "press-item",
          "settings": {
            "publication_name": "Motherly"
          }
        },
        {
          "type": "press-item",
          "settings": {
            "publication_name": "The Bump"
          }
        }
      ]
    }
  ]
}
{% endschema %}
