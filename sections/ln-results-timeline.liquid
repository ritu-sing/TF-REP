{% style %}
  #shopify-section-{{ section.id }} {
    --padding-block-start: {{ section.settings['padding-block-start'] }}px;
    --padding-block-end: {{ section.settings['padding-block-end'] }}px;
    --ln-tl-accent: {{ section.settings.accent_color }};
    --ln-tl-connector-color: {{ section.settings.connector_color }};
    --ln-tl-cta-bg: {{ section.settings.cta_bg_color }};
    --ln-tl-cta-text: {{ section.settings.cta_text_color }};
    --ln-tl-heading-font: var(--font-{{ section.settings.heading_font }}--family, inherit);
    --ln-tl-heading-size: {{ section.settings.heading_size }}px;
    --ln-tl-heading-weight: {{ section.settings.heading_weight }};
    --ln-tl-body-font: var(--font-{{ section.settings.body_font }}--family, inherit);
    --ln-tl-body-size: {{ section.settings.body_size }}px;
    --ln-tl-period-font: var(--font-{{ section.settings.period_font }}--family, inherit);
    --ln-tl-period-size: {{ section.settings.period_size }}px;
    {% if section.settings.heading_color != blank %}--ln-tl-heading-color: {{ section.settings.heading_color }};{% endif %}
    {% if section.settings.subheading_color != blank %}--ln-tl-subheading-color: {{ section.settings.subheading_color }};{% endif %}
    {% if section.settings.period_color != blank %}--ln-tl-period-color: {{ section.settings.period_color }};{% endif %}
    {% if section.settings.body_color != blank %}--ln-tl-body-color: {{ section.settings.body_color }};{% endif %}
  }
{% endstyle %}

<ln-timeline class="ln-timeline color-{{ section.settings.color_scheme }} ln-timeline--{{ section.settings.section_width }}">
  <div class="ln-timeline__inner">

    <div class="ln-timeline__header">
      {% if section.settings.heading != blank %}
        <h2 class="ln-timeline__heading">{{ section.settings.heading | strip_html }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="ln-timeline__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="ln-timeline__track" ref="track">
      {% for block in section.blocks %}
        <div class="ln-timeline__item" {{ block.shopify_attributes }}>
          <div class="ln-timeline__marker"></div>
          {% if block.settings.icon != blank %}
            <div class="ln-timeline__icon">
              {{ block.settings.icon | image_url: width: 96 | image_tag:
                widths: '48, 96',
                loading: 'lazy',
                alt: block.settings.heading
              }}
            </div>
          {% endif %}
          <span class="ln-timeline__period">{{ block.settings.period_label }}</span>
          <div class="ln-timeline__content">
            {% if block.settings.heading != blank %}
              <h3 class="ln-timeline__item-heading">{{ block.settings.heading }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="ln-timeline__item-desc">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.cta_text != blank and section.settings.cta_url != blank %}
      <div class="ln-timeline__cta">
        <a href="{{ section.settings.cta_url }}" class="ln-timeline__cta-btn">{{ section.settings.cta_text }}</a>
      </div>
    {% endif %}

  </div>
</ln-timeline>

<script src="{{ 'ln-results-timeline.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  ln-timeline {
    display: block;
    padding-block-start: var(--padding-block-start, 60px);
    padding-block-end: var(--padding-block-end, 60px);
  }

  .ln-timeline {
    padding-inline: 40px;
  }

  .ln-timeline--page-width {
    max-width: var(--page-content-width, 1280px);
    margin-inline: auto;
  }

  /* ── Inner container ──────────────────────────────────────────── */
  .ln-timeline__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* ── Header ───────────────────────────────────────────────────── */
  .ln-timeline__header {
    text-align: center;
  }

  .ln-timeline__heading {
    margin: 0 0 12px;
    font-family: var(--ln-tl-heading-font, var(--font-heading--family, inherit));
    font-weight: var(--ln-tl-heading-weight, 700);
    font-size: var(--ln-tl-heading-size, 2.25rem);
    line-height: 1.15;
    color: var(--ln-tl-heading-color, var(--color-foreground));
  }

  .ln-timeline__subheading {
    margin: 0 auto;
    max-width: 560px;
    font-family: var(--ln-tl-body-font, var(--font-body--family, inherit));
    font-size: var(--ln-tl-body-size, 1rem);
    line-height: 1.55;
    color: var(--ln-tl-subheading-color, var(--color-foreground));
    opacity: 0.75;
  }

  /* ── Track (horizontal connector) ────────────────────────────── */
  .ln-timeline__track {
    display: flex;
    position: relative;
    gap: 0;
  }

  .ln-timeline__track::before {
    content: '';
    position: absolute;
    top: 8px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--ln-tl-connector-color, #e0d5c7);
    z-index: 0;
  }

  /* ── Items ────────────────────────────────────────────────────── */
  .ln-timeline__item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    padding-inline: 16px;
  }

  .ln-timeline__marker {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: var(--ln-tl-accent, #680040);
    border: 3px solid var(--ln-tl-connector-color, #e0d5c7);
    z-index: 1;
    position: relative;
    flex-shrink: 0;
    margin-block-end: 16px;
  }

  .ln-timeline__icon {
    width: 48px;
    height: 48px;
    margin-block-end: 8px;
  }

  .ln-timeline__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ln-timeline__period {
    display: block;
    font-family: var(--ln-tl-period-font, var(--font-accent--family, inherit));
    font-size: var(--ln-tl-period-size, 0.875rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ln-tl-period-color, var(--ln-tl-accent, #680040));
    margin-block-end: 8px;
  }

  .ln-timeline__content {
    flex: 1;
  }

  .ln-timeline__item-heading {
    margin: 0 0 8px;
    font-family: var(--ln-tl-heading-font, var(--font-heading--family, inherit));
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--ln-tl-heading-color, var(--color-foreground));
  }

  .ln-timeline__item-desc {
    margin: 0;
    font-family: var(--ln-tl-body-font, var(--font-body--family, inherit));
    font-size: var(--ln-tl-body-size, 1rem);
    line-height: 1.55;
    color: var(--ln-tl-body-color, var(--color-foreground));
    opacity: 0.8;
  }

  /* ── CTA ──────────────────────────────────────────────────────── */
  .ln-timeline__cta {
    text-align: center;
  }

  .ln-timeline__cta-btn {
    display: inline-block;
    padding: 14px 32px;
    background-color: var(--ln-tl-cta-bg, #680040);
    color: var(--ln-tl-cta-text, #ffffff);
    text-decoration: none;
    border-radius: 84px;
    font-family: var(--ln-tl-body-font, var(--font-body--family, inherit));
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.03em;
    transition: opacity 0.2s ease;
  }

  .ln-timeline__cta-btn:hover {
    opacity: 0.9;
  }

  /* ── Mobile ───────────────────────────────────────────────────── */
  @media screen and (max-width: 749px) {
    .ln-timeline {
      padding-inline: 20px;
    }

    .ln-timeline__inner {
      gap: 32px;
    }

    .ln-timeline__header {
      text-align: left;
    }

    .ln-timeline__subheading {
      margin-inline: 0;
    }

    .ln-timeline__track {
      flex-direction: column;
      gap: 24px;
    }

    .ln-timeline__track::before {
      display: none;
    }

    .ln-timeline__item {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      padding-inline: 0;
      gap: 16px;
    }

    .ln-timeline__marker {
      margin-block-end: 0;
      margin-block-start: 4px;
      flex-shrink: 0;
    }

    .ln-timeline__icon {
      width: 40px;
      height: 40px;
      margin-block-end: 0;
      flex-shrink: 0;
    }
  }
{% endstylesheet %}

