{% liquid
  assign image_position = section.settings.desktop_image_position | default: 'right'
%}

<style>
  #shopify-section-{{ section.id }} {
    --section-heading-font: var(--font-{{ section.settings.heading_font }}--family);
    {%- unless section.settings.heading_size == 'auto' %}
    --section-heading-size: {{ section.settings.heading_size }};
    {%- endunless %}
    {%- if section.settings.heading_weight != blank %}
    --section-heading-weight: {{ section.settings.heading_weight }};
    {%- endif %}
    --section-body-font: var(--font-{{ section.settings.body_font }}--family);
    {%- unless section.settings.body_size == 'auto' %}
    --section-body-size: {{ section.settings.body_size }};
    {%- endunless %}
    {%- if section.settings.body_weight != blank %}
    --section-body-weight: {{ section.settings.body_weight }};
    {%- endif %}
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--full-width hero-banner color-{{ section.settings.color_scheme }} spacing-style"
  style="--hero-banner-min-height: {{ section.settings.desktop_min_height | default: 500 }}px; {% render 'spacing-style', settings: section.settings %}"
>
  <div class="hero-banner__grid{% if image_position == 'left' %} hero-banner__grid--image-left{% endif %}">
    <div class="hero-banner__image">
      {% if section.settings.image != blank %}
        {% if section.settings.image_mobile != blank %}
          {% assign desktop_sizes = '(min-width: 750px) 50vw, 100vw' %}
          {{
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag:
              sizes: desktop_sizes,
              widths: '375,550,750,1100,1500',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'hero-banner__image-el hero-banner__image-el--desktop',
              alt: section.settings.image.alt
          }}
          {% assign mobile_sizes = '100vw' %}
          {{
            section.settings.image_mobile
            | image_url: width: section.settings.image_mobile.width
            | image_tag:
              sizes: mobile_sizes,
              widths: '375,550,750',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'hero-banner__image-el hero-banner__image-el--mobile',
              alt: section.settings.image_mobile.alt
          }}
        {% else %}
          {% assign sizes_val = '(min-width: 750px) 50vw, 100vw' %}
          {{
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag:
              sizes: sizes_val,
              widths: '375,550,750,1100,1500',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'hero-banner__image-el',
              alt: section.settings.image.alt
          }}
        {% endif %}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-banner__placeholder' }}
      {% endif %}
    </div>

    <div class="hero-banner__content">
      <div class="hero-banner__text-block">
        {% if section.settings.subtitle != blank %}
          <p class="hero-banner__subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="hero-banner__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="hero-banner__description">{{ section.settings.description | escape }}</p>
        {% endif %}
      </div>

      {% if section.settings.button_text != blank %}
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="button hero-banner__button"
        >
          {{ section.settings.button_text | escape }}
        </a>
      {% endif %}

      {% if section.settings.show_trust_badges and section.blocks.size > 0 %}
        <div class="hero-banner__badges">
          {% for block in section.blocks %}
            {% if block.type == 'trust-badge' %}
              <div {{ block.shopify_attributes }}>
                {% render 'hero-banner-icon', icon: block.settings.icon, icon_type: block.settings.icon_type, label: block.settings.label %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-banner__grid {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
  }

  .hero-banner__image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .hero-banner__image-el {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .hero-banner__grid:hover .hero-banner__image-el {
    transform: scale(1.03);
  }

  .hero-banner__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-banner__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px 20px 28px 20px;
    background-color: var(--color-background);
  }

  .hero-banner__text-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero-banner__subtitle {
    font-family: var(--section-body-font, var(--font-body--family, sans-serif));
    font-weight: var(--section-body-weight, 600);
    font-size: var(--section-body-size, 12px);
    line-height: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }

  .hero-banner__heading {
    font-family: var(--section-heading-font, var(--font-heading--family, sans-serif));
    font-weight: var(--section-heading-weight, 700);
    font-size: var(--section-heading-size, 28px);
    line-height: 34px;
    text-transform: none;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .hero-banner__description {
    font-family: var(--section-body-font, var(--font-body--family, sans-serif));
    font-weight: var(--section-body-weight, 400);
    font-size: var(--section-body-size, 14px);
    line-height: 22px;
    color: var(--color-foreground);
    margin: 0;
  }

  .hero-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
    text-transform: uppercase;
    font-weight: 700;
    font-size: 14px;
    line-height: 14px;
    padding-block: 16px;
    padding-inline: 32px;
    width: 100%;
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: none;
    text-decoration: none;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .hero-banner__button:hover {
    background-color: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
    opacity: 1;
  }

  .hero-banner__badges {
    display: flex;
    flex-direction: row;
    gap: 12px;
    align-items: flex-start;
    flex-wrap: wrap;
    padding: 0;
  }

  .hero-banner__badge {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    width: 72px;
  }

  .hero-banner__badge-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hero-banner__badge-img {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .hero-banner__badge-label {
    font-weight: 500;
    font-size: 11px;
    line-height: 14px;
    text-align: center;
    color: var(--color-foreground);
  }

  .hero-banner__image-el--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .hero-banner__content {
      padding: 28px 20px;
    }

    .hero-banner__heading {
      font-size: var(--section-heading-size, 26px);
      line-height: 32px;
    }

    .hero-banner__subtitle {
      font-size: var(--section-body-size, 11px);
      line-height: 14px;
      letter-spacing: 1.5px;
    }

    .hero-banner__description {
      font-size: var(--section-body-size, 14px);
      line-height: 20px;
    }

    .hero-banner__button {
      width: 100%;
    }

    .hero-banner__badges {
      justify-content: flex-start;
    }

    .hero-banner__image-el--mobile {
      display: block;
    }

    .hero-banner__image-el--desktop {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .hero-banner__grid {
      grid-template-columns: 1fr 1fr;
      min-height: var(--hero-banner-min-height, 500px);
    }

    .hero-banner__grid--image-left .hero-banner__image {
      order: -1;
    }

    .hero-banner__image {
      aspect-ratio: auto;
      height: 100%;
      order: 1;
    }

    .hero-banner__content {
      align-self: center;
      padding: 56px 48px;
    }

    .hero-banner__heading {
      font-size: var(--section-heading-size, 36px);
      line-height: 44px;
    }

    .hero-banner__description {
      font-size: var(--section-body-size, 16px);
      line-height: 24px;
    }

    .hero-banner__subtitle {
      font-size: var(--section-body-size, 12px);
      line-height: 16px;
      letter-spacing: 2px;
    }

    .hero-banner__button {
      width: fit-content;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "1M+ UNITS SOLD | 10K+ 5 STAR REVIEWS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gummies That Start with Real Fruit. Not Candy."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Daily nutrition made from real ingredients, without the sugar rush or unnecessary extras."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Starter Pack"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "number",
      "id": "desktop_min_height",
      "label": "Desktop min height",
      "default": 500
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show trust badges",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
