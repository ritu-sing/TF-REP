{% stylesheet %}
.our-story {
  display: grid;
  grid-template-columns: 1fr;
  grid-template-areas:
    'media'
    'content';
}

.our-story__media {
  grid-area: media;
  overflow: hidden;
  aspect-ratio: 4 / 3;
}

.our-story__media img,
.our-story__media .our-story__placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.our-story__content {
  grid-area: content;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 24px;
  padding: 40px 24px;
}

.our-story__eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgb(var(--color-foreground-rgb) / 0.6);
  margin: 0;
}

.our-story__heading {
  font-family: var(--font-heading--family);
  font-weight: var(--font-heading--weight);
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  line-height: 1.2;
}

.our-story__heading h1,
.our-story__heading h2,
.our-story__heading h3,
.our-story__heading h4,
.our-story__heading h5,
.our-story__heading h6,
.our-story__heading p {
  margin: 0;
  font-size: inherit;
  font-weight: inherit;
  font-family: inherit;
  line-height: inherit;
}

.our-story__body {
  font-family: var(--font-body--family);
  font-size: 1rem;
  line-height: 1.6;
  color: rgb(var(--color-foreground-rgb) / 0.8);
}

.our-story__body p {
  margin: 0;
}

.our-story__button {
  display: inline-block;
  align-self: flex-start;
  padding: 14px 32px;
  border: 1.5px solid rgb(var(--color-foreground-rgb) / 0.8);
  text-decoration: none;
  font-family: var(--font-body--family);
  font-size: 0.875rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgb(var(--color-foreground-rgb));
  background-color: transparent;
  transition: background-color 0.2s, color 0.2s;
}

.our-story__button:hover {
  background-color: rgb(var(--color-foreground-rgb));
  color: var(--color-background);
}

@media screen and (min-width: 750px) {
  .our-story {
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'media content';
  }

  .our-story--image-right {
    grid-template-areas: 'content media';
  }

  .our-story__media {
    aspect-ratio: unset;
  }

  .our-story__content {
    padding: 64px 56px;
  }
}
{% endstylesheet %}

<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style our-story our-story--image-{{ section.settings.image_position }}"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  <div class="our-story__media">
    {%- if section.settings.image != blank -%}
      {%- render 'image', image: section.settings.image, class: 'our-story__image' -%}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'our-story__placeholder' }}
    {%- endif -%}
  </div>

  <div class="our-story__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="our-story__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <div class="our-story__heading">{{ section.settings.heading }}</div>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="our-story__body">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        class="our-story__button"
        {%- if section.settings.button_link != blank -%}
          href="{{ section.settings.button_link }}"
        {%- else -%}
          href="#"
        {%- endif -%}
      >
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Our Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "OUR STORY"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Real Ingredients. Real Results. Really For Kids.</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>We started Llama Naturals because our own kids deserved better. Better ingredients, better nutrition, and better taste — without the artificial junk. Every gummy we make is crafted from real fruit, certified organic, and third-party tested so you can feel confident in every bite.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "full-width",
          "label": "Full width"
        },
        {
          "value": "page-width",
          "label": "Page width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Our Story"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
