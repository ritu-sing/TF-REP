{% stylesheet %}
.our-story {
  display: grid;
  grid-template-columns: 1fr;
  grid-template-areas:
    'media'
    'content';
}

.our-story__media {
  grid-area: media;
  overflow: hidden;
  aspect-ratio: 4 / 3;
  position: relative;
}

.our-story__media img,
.our-story__media .our-story__placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.our-story__content {
  grid-area: content;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 24px;
  padding: 40px 24px;
}

.our-story__eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgb(var(--color-foreground-rgb) / 0.6);
  margin: 0;
}

.our-story__heading {
  font-family: var(--font-heading--family);
  font-weight: var(--font-heading--weight);
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  line-height: 1.2;
  color: var(--color-foreground-heading);
}

.our-story__heading h1,
.our-story__heading h2,
.our-story__heading h3,
.our-story__heading h4,
.our-story__heading h5,
.our-story__heading h6,
.our-story__heading p {
  margin: 0;
  font-size: inherit;
  font-weight: inherit;
  font-family: inherit;
  line-height: inherit;
  color: inherit;
}

.our-story__body {
  font-family: var(--font-body--family);
  font-size: 1rem;
  line-height: 1.6;
  color: rgb(var(--color-foreground-rgb) / 0.8);
}

.our-story__body p {
  margin: 0;
}

.our-story__button {
  display: inline-block;
  align-self: flex-start;
  padding: 14px 32px;
  border: 1.5px solid rgb(var(--color-foreground-rgb) / 0.8);
  text-decoration: none;
  font-family: var(--font-body--family);
  font-size: 0.875rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgb(var(--color-foreground-rgb));
  background-color: transparent;
  transition: background-color 0.2s, color 0.2s;
}

.our-story__button:hover {
  background-color: rgb(var(--color-foreground-rgb));
  color: var(--color-background);
}

.our-story__features {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.our-story__feature-item {
  display: flex;
  gap: 14px;
  align-items: flex-start;
}

.our-story__feature-icon {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  margin-top: 2px;
  color: rgb(var(--color-foreground-rgb));
}

.our-story__feature-text {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.our-story__feature-title {
  font-family: var(--font-heading--family);
  font-weight: var(--font-heading--weight);
  font-size: 0.9375rem;
  line-height: 1.4;
  margin: 0;
}

.our-story__feature-description {
  font-family: var(--font-body--family);
  font-size: 0.875rem;
  line-height: 1.5;
  color: rgb(var(--color-foreground-rgb) / 0.75);
  margin: 0;
}

.our-story__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  align-items: center;
}

.our-story__badge {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 54px;
  height: 54px;
  flex-shrink: 0;
  border: 1.5px solid rgb(var(--color-foreground-rgb));
  border-radius: 50%;
  font-family: var(--font-body--family);
  font-size: 0.5625rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgb(var(--color-foreground-rgb));
  text-align: center;
  line-height: 1.25;
  background-color: transparent;
  word-break: break-word;
  overflow-wrap: break-word;
  padding: 4px;
  position: relative;
  overflow: visible;
}

.our-story__badge::after {
  content: '';
  position: absolute;
  top: 50%;
  left: -4px;
  right: -4px;
  height: 1.5px;
  background-color: currentColor;
  transform: rotate(-30deg);
  transform-origin: center;
  pointer-events: none;
}

@media screen and (min-width: 750px) {
  .our-story {
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'media content';
  }

  .our-story--image-right {
    grid-template-areas: 'content media';
  }

  .our-story__media {
    aspect-ratio: unset;
  }

  .our-story__media--with-divider {
    border-right: 1px solid var(--our-story-divider-color, rgba(0,0,0,0.15));
  }

  .our-story--image-right .our-story__media--with-divider {
    border-right: none;
    border-left: 1px solid var(--our-story-divider-color, rgba(0,0,0,0.15));
  }

  .our-story__content {
    padding: 64px 56px;
  }
}
{% endstylesheet %}

{%- assign feature_blocks = section.blocks | where: 'type', 'feature-item' -%}
{%- assign badge_blocks = section.blocks | where: 'type', 'badge' -%}

{%- assign cs_id = section.settings.color_scheme -%}
{%- assign cs = settings.color_schemes[cs_id] -%}
{%- assign fg_rgb = cs.settings.foreground.rgb -%}
{%- assign fg_heading_rgba = cs.settings.foreground_heading.rgba -%}
{%- assign fg_heading_rgb = cs.settings.foreground_heading.rgb -%}

<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style our-story our-story--image-{{ section.settings.image_position }}"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  <div
    class="our-story__media{% if section.settings.show_divider %} our-story__media--with-divider{% endif %}"
    style="
      {%- if section.settings.left_panel_bg != blank and section.settings.left_panel_bg != 'rgba(0,0,0,0)' -%}
        background-color: {{ section.settings.left_panel_bg }};
      {%- endif -%}
      {%- if section.settings.show_divider -%}
        --our-story-divider-color: {{ section.settings.divider_color }};
      {%- endif -%}
    "
  >
    {%- if section.settings.image != blank -%}
      {%- render 'image', image: section.settings.image, class: 'our-story__image' -%}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'our-story__placeholder' }}
    {%- endif -%}
  </div>

  <div
    class="our-story__content"
    style="
      {%- if section.settings.right_panel_bg != blank and section.settings.right_panel_bg != 'rgba(0,0,0,0)' -%}
        background-color: {{ section.settings.right_panel_bg }};
      {%- endif -%}
      {%- if fg_rgb != blank -%}
        --color-foreground-rgb: {{ fg_rgb }};
        --color-foreground: rgb({{ fg_rgb }});
        --color-foreground-heading: rgb({{ fg_heading_rgba }});
        --color-foreground-heading-rgb: {{ fg_heading_rgb }};
      {%- endif -%}
    "
  >
    {%- if section.settings.eyebrow != blank -%}
      <p class="our-story__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <div class="our-story__heading">{{ section.settings.heading }}</div>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="our-story__body">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if feature_blocks.size > 0 -%}
      <div class="our-story__features">
        {%- for block in feature_blocks -%}
          <div class="our-story__feature-item" {{ block.shopify_attributes }}>
            <svg class="our-story__feature-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/>
              <path d="M7.5 12.5l3 3 6-6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div class="our-story__feature-text">
              {%- if block.settings.title != blank -%}
                <p class="our-story__feature-title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="our-story__feature-description">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if badge_blocks.size > 0 -%}
      <div class="our-story__badges">
        {%- for block in badge_blocks -%}
          {%- if block.settings.label != blank -%}
            <span class="our-story__badge" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        class="our-story__button"
        {%- if section.settings.button_link != blank -%}
          href="{{ section.settings.button_link }}"
        {%- else -%}
          href="#"
        {%- endif -%}
      >
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Our Story",
  "blocks": [
    {
      "type": "feature-item",
      "name": "Feature item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        }
      ]
    },
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "OUR STORY"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Real Ingredients. Real Results. Really For Kids.</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>We started Llama Naturals because our own kids deserved better. Better ingredients, better nutrition, and better taste — without the artificial junk. Every gummy we make is crafted from real fruit, certified organic, and third-party tested so you can feel confident in every bite.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "full-width",
          "label": "Full width"
        },
        {
          "value": "page-width",
          "label": "Page width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Panel backgrounds"
    },
    {
      "type": "color",
      "id": "left_panel_bg",
      "label": "Left panel background"
    },
    {
      "type": "color",
      "id": "right_panel_bg",
      "label": "Right panel background"
    },
    {
      "type": "header",
      "content": "Panel divider"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider between panels",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#3D1534"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Our Story"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
