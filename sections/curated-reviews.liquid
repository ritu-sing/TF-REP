{%- liquid
  assign slide_count = section.blocks.size
  assign show_arrows_val = section.settings.show_arrows
-%}

{%- capture slides -%}
  {%- for block in section.blocks -%}
    {%- capture card_content -%}
      <div class="curated-reviews__card" {{ block.shopify_attributes }}>
        <div class="curated-reviews__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
          {%- for i in (1..5) -%}
            <svg
              class="curated-reviews__star{% if i <= block.settings.rating %} curated-reviews__star--filled{% endif %}"
              viewBox="0 0 32 32"
              xmlns="http://www.w3.org/2000/svg"
              role="presentation"
              aria-hidden="true"
            >
              <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
            </svg>
          {%- endfor -%}
        </div>
        <p class="curated-reviews__text">{{ block.settings.review_text }}</p>
        <div class="curated-reviews__reviewer">
          <span class="curated-reviews__name">{{ block.settings.reviewer_name }}</span>
          {%- if block.settings.verified -%}
            <span class="curated-reviews__verified">
              <svg
                class="curated-reviews__checkmark"
                viewBox="0 0 16 16"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
                role="presentation"
              >
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M8 16A8 8 0 108 0a8 8 0 000 16zm3.78-9.72a.75.75 0 00-1.06-1.06L7 8.94 5.28 7.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.06 0l4.25-4.25z"
                  fill="currentColor"
                />
              </svg>
              {{ block.settings.verified_label }}
            </span>
          {%- endif -%}
        </div>
      </div>
    {%- endcapture -%}
    {%- render 'slideshow-slide',
      index: forloop.index0,
      children: card_content,
      class: 'curated-reviews__slide'
    -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture controls -%}
  {%- render 'slideshow-controls',
    style: 'dots',
    item_count: slide_count,
    show_arrows: show_arrows_val,
    icon_style: section.settings.icons_style,
    shape: section.settings.icons_shape
  -%}
{%- endcapture -%}

{%- capture slideshow_style -%}
  --curated-reviews-columns: {{ section.settings.columns }};
  --curated-reviews-star-color: {{ section.settings.star_color }};
  {%- render 'gap-style', value: section.settings.gap, name: 'curated-reviews-gap' -%}
{%- endcapture -%}

<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  {%- if section.settings.heading != blank -%}
    <h2
      class="curated-reviews__heading"
      style="text-align: {{ section.settings.heading_alignment }};"
    >
      {{ section.settings.heading | escape }}
    </h2>
  {%- endif -%}

  {%- render 'slideshow',
    class: 'curated-reviews__slideshow',
    style: slideshow_style,
    slides: slides,
    slide_count: slide_count,
    show_arrows: false,
    auto_hide_controls: true,
    infinite: false,
    controls: controls
  -%}
</div>

{% stylesheet %}
  .curated-reviews__heading {
    margin: 0 0 var(--margin-4xl);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    color: var(--color-foreground-heading);
  }

  .curated-reviews__slideshow slideshow-slides {
    --slideshow-gap: var(--curated-reviews-gap, 24px);
  }

  .curated-reviews__slideshow slideshow-container {
    background-color: transparent;
  }

  .curated-reviews__slide {
    flex: 0 0 auto;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .curated-reviews__slide {
      width: calc(
        (100% - (var(--curated-reviews-gap, 24px) * (var(--curated-reviews-columns, 3) - 1))) /
          var(--curated-reviews-columns, 3)
      );
    }

    .curated-reviews__slideshow slideshow-controls {
      display: none;
    }

    .curated-reviews__slideshow slideshow-arrows {
      display: none;
    }
  }

  .curated-reviews__card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    padding: var(--padding-2xl);
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-sm);
    height: 100%;
  }

  .curated-reviews__stars {
    display: flex;
    gap: var(--gap-3xs);
    align-items: center;
  }

  .curated-reviews__star {
    width: 1.125rem;
    height: 1.125rem;
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .curated-reviews__star--filled {
    fill: var(--curated-reviews-star-color, #FFB800);
  }

  .curated-reviews__text {
    font-family: var(--font-body--family);
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
    color: var(--color-foreground);
    margin: 0;
    flex-grow: 1;
  }

  .curated-reviews__text::before {
    content: '\201C';
  }

  .curated-reviews__text::after {
    content: '\201D';
  }

  .curated-reviews__reviewer {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    flex-wrap: wrap;
  }

  .curated-reviews__name {
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: var(--font-size--sm);
    color: var(--color-foreground-heading);
  }

  .curated-reviews__verified {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-3xs);
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    color: var(--color-primary);
  }

  .curated-reviews__checkmark {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .curated-reviews__slideshow slideshow-controls:has(.slideshow-controls__dots) {
    mix-blend-mode: normal;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Curated Reviews",
  "class": "curated-reviews",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#FFB800"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Icon style",
      "options": [
        { "value": "arrow", "label": "Arrow" },
        { "value": "chevron", "label": "Chevron" }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.show_arrows }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Icon shape",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.show_arrows }}"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review-card",
      "name": "Review card",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "This product exceeded my expectations. The quality is amazing and it arrived faster than expected!"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer name",
          "default": "Jane D."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified buyer",
          "default": true
        },
        {
          "type": "text",
          "id": "verified_label",
          "label": "Verified label",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curated Reviews",
      "blocks": [
        {
          "type": "review-card",
          "settings": {
            "rating": 5,
            "review_text": "We love these vitamins! My kids ask for them every morning. The taste is great and I feel good knowing they are getting clean, plant-based nutrition.",
            "reviewer_name": "Sarah M.",
            "verified": true,
            "verified_label": "Verified Buyer"
          }
        },
        {
          "type": "review-card",
          "settings": {
            "rating": 5,
            "review_text": "Finally a vitamin my picky eater will take! No artificial junk, and they actually taste like real fruit. We have been using them for 3 months now and love the results.",
            "reviewer_name": "Jessica T.",
            "verified": true,
            "verified_label": "Verified Buyer"
          }
        },
        {
          "type": "review-card",
          "settings": {
            "rating": 4,
            "review_text": "Great quality gummies that the whole family enjoys. I appreciate the transparency about ingredients. Would definitely recommend to other parents!",
            "reviewer_name": "Michael R.",
            "verified": true,
            "verified_label": "Verified Buyer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
