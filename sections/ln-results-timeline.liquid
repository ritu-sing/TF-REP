          }
        },
        {
          "type": "timeline-item",
          "settings": {
            "period_label": "Month 3 And Beyond",
            "heading": "The Whole Family Is In",
            "description": "Kids are set. Parents start ordering for themselves."
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
