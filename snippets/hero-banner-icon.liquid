{% doc %}
  Hero Banner Trust Badge Icon

  Renders a single trust badge with a 48x48 icon and a centered label below.

  @param {object} icon - Shopify image object from image_picker (optional)
  @param {string} icon_type - Predefined icon key: parent-owned, third-party-tested, allergen-free, usda-organic (optional)
  @param {string} label - Badge label text (required)
  @param {string} icon_color - Icon accent color for SVG stroke/fill (default: '#680040')

  @example
    {% render 'hero-banner-icon', icon: block.settings.icon, icon_type: block.settings.icon_type, label: block.settings.label %}
{% enddoc %}

{% liquid
  assign label = label | default: ''
  assign icon_color = icon_color | default: '#680040'
  assign icon_type = icon_type | default: 'none'
%}

<div class="hero-banner__badge">
  <div class="hero-banner__badge-icon">
    {% if icon != blank %}
      {{ icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: label, class: 'hero-banner__badge-img' }}
    {% elsif icon_type == 'parent-owned' %}
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="24" cy="24" r="23" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" />
        <circle cx="17" cy="18" r="3" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" />
        <circle cx="31" cy="18" r="3" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" />
        <path d="M17 22c-3 0-5 2-5 5v3h10v-3c0-3-2-5-5-5z" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M31 22c-3 0-5 2-5 5v3h10v-3c0-3-2-5-5-5z" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="24" cy="32" r="2.5" fill="{{ icon_color }}" />
        <path d="M21.5 34.5Q22.5 37 24 37t2.5-2.5" stroke="{{ icon_color }}" stroke-width="1.2" fill="none" stroke-linecap="round" />
      </svg>
    {% elsif icon_type == 'third-party-tested' %}
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="24" cy="24" r="23" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" />
        <path d="M24 10l-10 5v8c0 7.5 4.5 13.5 10 15 5.5-1.5 10-7.5 10-15v-8l-10-5z" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" stroke-linejoin="round" />
        <path d="M18 24l4 4 8-8" stroke="{{ icon_color }}" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    {% elsif icon_type == 'allergen-free' %}
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="24" cy="24" r="23" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" />
        <path d="M24 12c-6 0-11 5-11 11 0 2 .5 3.5 1.5 5" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" stroke-linecap="round" />
        <path d="M16 34c2.5 1.5 5 2 8 2 6 0 11-5 11-11 0-2-.5-3.5-1.5-5" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" stroke-linecap="round" />
        <path d="M24 18c-2 0-4 1.5-4 4 0 1.5 1 3 2.5 3.5" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" stroke-linecap="round" />
        <path d="M25.5 28c1.5-.5 2.5-2 2.5-3.5 0-2.5-2-4-4-4" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" stroke-linecap="round" />
        <line x1="14" y1="34" x2="34" y2="14" stroke="{{ icon_color }}" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    {% elsif icon_type == 'usda-organic' %}
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="24" cy="24" r="23" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" />
        <circle cx="24" cy="24" r="19" stroke="{{ icon_color }}" stroke-width="1" fill="none" />
        <path d="M24 14c-4 0-8 3-8 8 0 3 2 5 4 6 2 1 4 2 4 4v4" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M24 14c4 0 8 3 8 8 0 3-2 5-4 6-2 1-4 2-4 4" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M20 22c1-1 2.5-1.5 4-1.5s3 .5 4 1.5" stroke="{{ icon_color }}" stroke-width="1.2" fill="none" stroke-linecap="round" />
      </svg>
    {% else %}
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="24" cy="24" r="23" stroke="{{ icon_color }}" stroke-width="1.5" fill="none" />
        <circle cx="24" cy="24" r="7" fill="{{ icon_color }}" />
      </svg>
    {% endif %}
  </div>
  {% if label != blank %}
    <span class="hero-banner__badge-label">{{ label | escape }}</span>
  {% endif %}
</div>
