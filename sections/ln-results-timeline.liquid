      "label": "Period label size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon background color"
    },
    {
      "type": "color",
      "id": "image_col_bg_color",
      "label": "Image column background",
