<style>
  #shopify-section-{{ section.id }} {
    --ct-llama-bg: {{ section.settings.llama_col_bg }};
    --ct-llama-fg: {{ section.settings.llama_col_fg }};
    --ct-check-bg: {{ section.settings.check_icon_color }};
    --ct-cross-bg: {{ section.settings.cross_icon_color }};
  }

  #shopify-section-{{ section.id }} .comparison-table__cta {
    border-radius: 50px;
    --button-background-color: {{ section.settings.cta_bg_color }};
    --button-color: {{ section.settings.cta_text_color }};
    --button-border-color: {{ section.settings.cta_bg_color }};
  }
</style>

{%- capture ct_check_icon -%}
<svg class="comparison-table__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="var(--ct-check-bg)"/><path d="M8 17 L13 22 L24 11" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
{%- endcapture -%}

{%- capture ct_cross_icon -%}
<svg class="comparison-table__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="var(--ct-cross-bg)"/><path d="M10 10 L22 22 M22 10 L10 22" stroke="white" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg>
{%- endcapture -%}

<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  <div class="comparison-table__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="comparison-table__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="comparison-table__wrapper">
      <table class="comparison-table__table">
        <thead>
          <tr class="comparison-table__header-row">
            <th class="comparison-table__th comparison-table__th--feature" scope="col"></th>
            <th class="comparison-table__th comparison-table__th--llama" scope="col">
              {%- if section.settings.llama_header_logo != blank -%}
                {{- section.settings.llama_header_logo | image_url: width: 240 | image_tag:
                  loading: 'lazy',
                  class: 'comparison-table__header-logo',
                  alt: section.settings.llama_col_label
                -}}
              {%- else -%}
                {{ section.settings.llama_col_label | escape }}
              {%- endif -%}
            </th>
            <th class="comparison-table__th comparison-table__th--competitor" scope="col">
              {{ section.settings.competitor_col_label | escape }}
            </th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <tr class="comparison-table__row" {{ block.shopify_attributes }}>
                <td class="comparison-table__cell comparison-table__cell--feature">
                  {{ block.settings.label | escape }}
                </td>
                <td class="comparison-table__cell comparison-table__cell--llama">
                  {%- if block.settings.llama_value != blank -%}
                    {{ block.settings.llama_value | escape }}
                  {%- elsif block.settings.llama_has -%}
                    {{ ct_check_icon }}
                  {%- else -%}
                    {{ ct_cross_icon }}
                  {%- endif -%}
                </td>
                <td class="comparison-table__cell comparison-table__cell--competitor">
                  {%- if block.settings.competitor_value != blank -%}
                    {{ block.settings.competitor_value | escape }}
                  {%- elsif block.settings.competitor_has -%}
                    {{ ct_check_icon }}
                  {%- else -%}
                    {{ ct_cross_icon }}
                  {%- endif -%}
                </td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.show_cta and section.settings.cta_text != blank -%}
      <div class="comparison-table__cta-wrapper">
        <a href="{{ section.settings.cta_url }}" class="comparison-table__cta button">
          {{ section.settings.cta_text | escape }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .comparison-table__inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .comparison-table__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    line-height: 1.15;
    color: var(--color-foreground-heading);
    text-align: center;
  }

  .comparison-table__wrapper {
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .comparison-table__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .comparison-table__th {
    padding: 14px 8px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.3;
    color: var(--color-foreground-heading);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    text-align: center;
    vertical-align: middle;
  }

  .comparison-table__th--feature {
    width: 35%;
    text-align: start;
    padding-inline-start: 14px;
  }

  .comparison-table__th--llama {
    width: 38%;
    background-color: var(--ct-llama-bg);
    color: var(--ct-llama-fg);
  }

  .comparison-table__th--competitor {
    width: 27%;
    color: var(--ct-cross-bg);
  }

  .comparison-table__header-logo {
    display: block;
    max-width: 100%;
    max-height: 44px;
    width: auto;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
  }

  .comparison-table__row {
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
  }

  .comparison-table__row:last-child {
    border-bottom: none;
  }

  .comparison-table__cell {
    padding: 12px 8px;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-foreground);
    text-align: center;
    vertical-align: middle;
  }

  .comparison-table__cell--feature {
    text-align: start;
    font-weight: 500;
    padding-inline-start: 14px;
  }

  .comparison-table__cell--llama {
    background-color: var(--ct-llama-bg);
    color: var(--ct-llama-fg);
    font-weight: 600;
  }

  .comparison-table__icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
    width: 22px;
    height: 22px;
  }

  .comparison-table__cta-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-block-start: 8px;
  }

  .comparison-table__cta {
    border-radius: 50px;
    min-width: 200px;
    width: 80%;
    max-width: 360px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .comparison-table__inner {
      gap: 48px;
    }

    .comparison-table__th {
      padding: 22px 28px;
      font-size: 0.75rem;
      letter-spacing: 0.07em;
    }

    .comparison-table__th--feature {
      padding-inline-start: 36px;
    }

    .comparison-table__cell {
      padding: 18px 28px;
      font-size: 1rem;
    }

    .comparison-table__cell--feature {
      padding-inline-start: 36px;
    }

    .comparison-table__icon {
      width: 28px;
      height: 28px;
    }

    .comparison-table__header-logo {
      max-height: 56px;
    }

    .comparison-table__cta {
      width: auto;
      min-width: 280px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comparison table",
  "class": "comparison-table",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Difference Is Clear..."
    },
    {
      "type": "header",
      "content": "Column labels"
    },
    {
      "type": "image_picker",
      "id": "llama_header_logo",
      "label": "Brand column logo image"
    },
    {
      "type": "text",
      "id": "llama_col_label",
      "label": "Brand column label",
      "info": "Shown if no logo image is set",
      "default": "LLAMA NATURALS"
    },
    {
      "type": "text",
      "id": "competitor_col_label",
      "label": "Competitor column label",
      "default": "REGULAR GUMMIES"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "llama_col_bg",
      "label": "Brand column background",
      "default": "#edba9d"
    },
    {
      "type": "color",
      "id": "llama_col_fg",
      "label": "Brand column text color",
      "default": "#3d1534"
    },
    {
      "type": "color",
      "id": "check_icon_color",
      "label": "Check icon circle color",
      "default": "#3d1534"
    },
    {
      "type": "color",
      "id": "cross_icon_color",
      "label": "Cross icon circle color",
      "default": "#e05a4e"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA background color",
      "default": "#3d1534"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-7"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Feature label",
          "default": "Feature"
        },
        {
          "type": "header",
          "content": "Brand column"
        },
        {
          "type": "text",
          "id": "llama_value",
          "label": "Text value",
          "info": "Shows this text. Leave empty to show a check or cross icon."
        },
        {
          "type": "checkbox",
          "id": "llama_has",
          "label": "Has this feature (icon mode)",
          "default": true
        },
        {
          "type": "header",
          "content": "Competitor column"
        },
        {
          "type": "text",
          "id": "competitor_value",
          "label": "Text value",
          "info": "Shows this text. Leave empty to show a check or cross icon."
        },
        {
          "type": "checkbox",
          "id": "competitor_has",
          "label": "Has this feature (icon mode)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Made With",
            "llama_value": "Fruits & Veggies",
            "llama_has": true,
            "competitor_value": "Sugar & Sweeteners",
            "competitor_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Vitamins",
            "llama_value": "Whole Food",
            "llama_has": true,
            "competitor_value": "Synthetic",
            "competitor_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Certified Organic",
            "llama_has": true,
            "competitor_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Vegan & Allergen Free",
            "llama_has": true,
            "competitor_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Tastes Like",
            "llama_value": "Real Fruit",
            "llama_has": true,
            "competitor_value": "Candy",
            "competitor_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Money Back Guarantee",
            "llama_value": "100 Days",
            "llama_has": true,
            "competitor_has": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
