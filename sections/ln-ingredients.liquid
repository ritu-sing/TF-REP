{% style %}
  #shopify-section-{{ section.id }} {
    --padding-block-start: {{ section.settings['padding-block-start'] }}px;
    --padding-block-end: {{ section.settings['padding-block-end'] }}px;
    --ln-ingredients-columns: {{ section.settings.columns }};
    --ln-ingredients-mobile-columns: {{ section.settings.mobile_columns }};
    --ln-ingredients-icon-size: {{ section.settings.icon_size }}px;
    --ln-ingredients-gap: {{ section.settings.gap }}px;
  }
{% endstyle %}

<div class="ln-ingredients color-{{ section.settings.color_scheme }} ln-ingredients--{{ section.settings.section_width }}">
  {% if section.settings.heading != blank or section.settings.subheading != blank %}
    <div class="ln-ingredients__header">
      {% if section.settings.heading != blank %}
        <h2 class="ln-ingredients__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="ln-ingredients__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <ul class="ln-ingredients__grid" role="list">
      {% for block in section.blocks %}
        <li class="ln-ingredients__item" {{ block.shopify_attributes }}>
          <div class="ln-ingredients__icon-wrap">
            {% if block.settings.icon != blank %}
              {{ block.settings.icon | image_url: width: 200 | image_tag:
                widths: '100, 200',
                loading: 'lazy',
                alt: block.settings.name,
                class: 'ln-ingredients__icon'
              }}
            {% else %}
              <div class="ln-ingredients__icon-placeholder"></div>
            {% endif %}
          </div>
          {% if block.settings.name != blank %}
            <span class="ln-ingredients__name">{{ block.settings.name }}</span>
          {% endif %}
          {% if block.settings.description != blank %}
            <span class="ln-ingredients__description">{{ block.settings.description }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% stylesheet %}
  .ln-ingredients {
    padding-block-start: var(--padding-block-start, 48px);
    padding-block-end: var(--padding-block-end, 48px);
    padding-inline: 64px;
  }

  .ln-ingredients--page-width {
    max-width: var(--page-content-width, 1200px);
    margin-inline: auto;
  }

  .ln-ingredients__header {
    text-align: center;
    margin-block-end: 40px;
  }

  .ln-ingredients__heading {
    margin: 0 0 8px;
    font-family: var(--font-heading--family, inherit);
    font-weight: 700;
  }

  .ln-ingredients__subheading {
    margin: 0;
    font-family: var(--font-body--family, inherit);
    opacity: 0.75;
  }

  .ln-ingredients__grid {
    display: grid;
    grid-template-columns: repeat(var(--ln-ingredients-columns, 5), 1fr);
    gap: var(--ln-ingredients-gap, 24px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ln-ingredients__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .ln-ingredients__icon-wrap {
    width: var(--ln-ingredients-icon-size, 100px);
    height: var(--ln-ingredients-icon-size, 100px);
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ln-ingredients__icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ln-ingredients__icon-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-border, #e0ddd9);
  }

  .ln-ingredients__name {
    font-family: var(--font-subheading--family, var(--font-body--family, inherit));
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.3;
  }

  .ln-ingredients__description {
    font-family: var(--font-body--family, inherit);
    font-size: 0.75rem;
    opacity: 0.7;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ln-ingredients {
      padding-inline: 16px;
    }

    .ln-ingredients__icon-wrap {
      width: 72px;
      height: 72px;
    }

    .ln-ingredients__grid {
      grid-template-columns: repeat(var(--ln-ingredients-mobile-columns, 3), 1fr);
    }

    .ln-ingredients__header {
      margin-block-end: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredients",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Key Ingredients"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clinically studied nutrients, crafted for growing bodies"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 3,
      "max": 7,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns (mobile)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 60,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid gap",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "ingredient-item",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Vitamin C"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Immune support"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        {
          "type": "ingredient-item",
          "settings": { "name": "Vitamin C", "description": "Immune support" }
        },
        {
          "type": "ingredient-item",
          "settings": { "name": "Vitamin D3", "description": "Bone health" }
        },
        {
          "type": "ingredient-item",
          "settings": { "name": "Zinc", "description": "Growth & immunity" }
        },
        {
          "type": "ingredient-item",
          "settings": { "name": "Iodine", "description": "Brain development" }
        },
        {
          "type": "ingredient-item",
          "settings": { "name": "B Vitamins", "description": "Energy & mood" }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
