<div
  class="ln-trust-icons"
  {{ block.shopify_attributes }}
  style="padding-block-start: {{ block.settings['padding-block-start'] }}px; padding-block-end: {{ block.settings['padding-block-end'] }}px;"
>
  {%- for i in (1..4) -%}
    {%- assign img_key = 'icon_image_' | append: i -%}
    {%- assign lbl_key = 'icon_label_' | append: i -%}
    {%- assign img = block.settings[img_key] -%}
    {%- assign lbl = block.settings[lbl_key] -%}
    {%- if img != blank or lbl != blank -%}
      <div class="ln-trust-icons__item">
        {%- if img != blank -%}
          <div class="ln-trust-icons__img-wrap">
            {% render 'image',
              image: img,
              height: 64,
              class: 'ln-trust-icons__img',
              alt_text_fallback: lbl
            %}
          </div>
        {%- else -%}
          <div class="ln-trust-icons__img-wrap ln-trust-icons__img-wrap--placeholder"></div>
        {%- endif -%}
        {%- if lbl != blank -%}
          <span class="ln-trust-icons__label">{{ lbl }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% stylesheet %}
  .ln-trust-icons {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ln-trust-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
    min-width: 60px;
  }

  .ln-trust-icons__img-wrap {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ln-trust-icons__img-wrap--placeholder {
    background: var(--color-border, #e0e0e0);
  }

  .ln-trust-icons__img {
    width: 60px !important;
    height: 60px !important;
    object-fit: cover;
    border-radius: 50%;
  }

  .ln-trust-icons__label {
    font-size: 0.75rem;
    font-weight: 500;
    text-align: center;
    color: var(--color-foreground);
    line-height: 1.3;
    max-width: 72px;
  }

  @media screen and (max-width: 749px) {
    .ln-trust-icons {
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Icons Row",
  "settings": [
    {
      "type": "header",
      "content": "Icon 1"
    },
    {
      "type": "image_picker",
      "id": "icon_image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "icon_label_1",
      "label": "Label",
      "default": "Parent Owned"
    },
    {
      "type": "header",
      "content": "Icon 2"
    },
    {
      "type": "image_picker",
      "id": "icon_image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "icon_label_2",
      "label": "Label",
      "default": "3rd Party Tested"
    },
    {
      "type": "header",
      "content": "Icon 3"
    },
    {
      "type": "image_picker",
      "id": "icon_image_3",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "icon_label_3",
      "label": "Label",
      "default": "Allergen Free"
    },
    {
      "type": "header",
      "content": "Icon 4"
    },
    {
      "type": "image_picker",
      "id": "icon_image_4",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "icon_label_4",
      "label": "Label",
      "default": "USDA Organic"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ]
}
{% endschema %}
