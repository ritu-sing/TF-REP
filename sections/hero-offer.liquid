<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">

<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style hero-offer"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  <div class="hero-offer__inner">

    {%- comment -%} Gallery: main image + thumbnail strip {%- endcomment -%}
    <div class="hero-offer__gallery" id="hero-offer-gallery-{{ section.id }}">
      {%- assign main_display_image = section.settings.gallery_image_1 | default: section.settings.hero_image -%}
      <div class="hero-offer__image-wrap">
        {%- if main_display_image != blank -%}
          {%- assign hero_sizes = '(min-width: 750px) 50vw, 100vw' -%}
          {{
            main_display_image
            | image_url: width: main_display_image.width
            | image_tag:
              sizes: hero_sizes,
              widths: '390,780,1100',
              loading: 'lazy',
              alt: main_display_image.alt,
              class: 'hero-offer__image-el hero-offer__main-img'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-offer__image-placeholder' }}
        {%- endif -%}
      </div>

      {%- comment -%} Thumbnail strip — only renders when at least one gallery image is set {%- endcomment -%}
      {%- assign has_gallery_thumbs = false -%}
      {%- for i in (1..5) -%}
        {%- assign gkey = 'gallery_image_' | append: i -%}
        {%- if section.settings[gkey] != blank -%}
          {%- assign has_gallery_thumbs = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if has_gallery_thumbs -%}
        <div class="hero-offer__thumbs">
          {%- for i in (1..5) -%}
            {%- assign gkey = 'gallery_image_' | append: i -%}
            {%- assign gimg = section.settings[gkey] -%}
            {%- if gimg != blank -%}
              <button
                class="hero-offer__thumb{% if forloop.first %} hero-offer__thumb--active{% endif %}"
                type="button"
                data-src="{{ gimg | image_url: width: 1100 }}"
                data-srcset="{{ gimg | image_url: width: 390 }} 390w, {{ gimg | image_url: width: 780 }} 780w, {{ gimg | image_url: width: 1100 }} 1100w"
                data-alt="{{ gimg.alt | escape }}"
                aria-label="{{ gimg.alt | default: 'Gallery image' | escape }}"
              >
                {{
                  gimg
                  | image_url: width: 120
                  | image_tag:
                    width: 60,
                    height: 60,
                    loading: 'lazy',
                    alt: gimg.alt
                }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Content Panel {%- endcomment -%}
    <div class="hero-offer__content">

      {%- comment -%} Product Details block {%- endcomment -%}
      <div class="hero-offer__product-details">

        {%- comment -%} Rating row {%- endcomment -%}
        <div class="hero-offer__rating" aria-label="Rating">
          {%- assign full_stars = section.settings.full_stars | default: 4 -%}
          {%- assign half_star_index = full_stars | plus: 1 -%}
          {%- for i in (1..5) -%}
            {%- if i <= full_stars -%}
              <svg class="hero-offer__star" width="12" height="12" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M6 0.5l1.545 3.13 3.455.502-2.5 2.437.59 3.44L6 8.385 2.91 9.01l.59-3.44L1 3.132l3.455-.502z" fill="#F58232"/>
              </svg>
            {%- elsif i == half_star_index and section.settings.show_half_star -%}
              <svg class="hero-offer__star hero-offer__star--half" width="12" height="12" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <clipPath id="hero-offer-half-clip-{{ section.id }}">
                    <rect x="0" y="0" width="6" height="12"/>
                  </clipPath>
                </defs>
                <path d="M6 0.5l1.545 3.13 3.455.502-2.5 2.437.59 3.44L6 8.385 2.91 9.01l.59-3.44L1 3.132l3.455-.502z" fill="#e0e0e0"/>
                <path d="M6 0.5l1.545 3.13 3.455.502-2.5 2.437.59 3.44L6 8.385 2.91 9.01l.59-3.44L1 3.132l3.455-.502z" fill="#F58232" clip-path="url(#hero-offer-half-clip-{{ section.id }})"/>
              </svg>
            {%- else -%}
              <svg class="hero-offer__star hero-offer__star--empty" width="12" height="12" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M6 0.5l1.545 3.13 3.455.502-2.5 2.437.59 3.44L6 8.385 2.91 9.01l.59-3.44L1 3.132l3.455-.502z" fill="#e0e0e0"/>
              </svg>
            {%- endif -%}
          {%- endfor -%}
          {%- if section.settings.review_count != blank -%}
            <span class="hero-offer__review-count">{{ section.settings.review_count }}</span>
          {%- endif -%}
        </div>

        {%- comment -%} Heading {%- endcomment -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hero-offer__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- comment -%} Price row {%- endcomment -%}
        <div class="hero-offer__price-row">
          {%- if section.settings.current_price != blank -%}
            <span class="hero-offer__price-current">{{ section.settings.current_price }}</span>
          {%- endif -%}
          {%- if section.settings.original_price != blank -%}
            <span class="hero-offer__price-original">{{ section.settings.original_price }}</span>
          {%- endif -%}
        </div>

        {%- comment -%} Benefit bullets {%- endcomment -%}
        {%- assign has_benefits = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            {%- assign has_benefits = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if has_benefits -%}
          <ul class="hero-offer__benefits">
            {%- for block in section.blocks -%}
              {%- if block.type == 'benefit' -%}
                <li class="hero-offer__benefit-item" {{ block.shopify_attributes }}>
                  <span class="hero-offer__check-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="8" cy="8" r="7" fill="none" stroke="#000000" stroke-width="1.5"/>
                      <path d="M5 8l2 2 4-4" fill="none" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                  <span class="hero-offer__benefit-text">{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Product item rows {%- endcomment -%}
      <div class="hero-offer__product-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product-item' -%}
          <div class="hero-offer__product-row" {{ block.shopify_attributes }}>
            <div class="hero-offer__product-icon">
              {%- if block.settings.is_gift -%}
                <svg width="25" height="28" viewBox="0 0 25 28" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <rect x="1" y="9" width="23" height="5" rx="1" fill="none" stroke="#FFFEF5" stroke-width="1.2"/>
                  <rect x="3" y="14" width="19" height="13" rx="1" fill="none" stroke="#FFFEF5" stroke-width="1.2"/>
                  <line x1="12.5" y1="9" x2="12.5" y2="27" stroke="#FFFEF5" stroke-width="1.2"/>
                  <path d="M12.5 9 C12.5 9 9 7 9 4.5 C9 2.5 10.5 1.5 12 2.5 C12.5 3 12.5 4 12.5 4" fill="none" stroke="#FFFEF5" stroke-width="1.2" stroke-linecap="round"/>
                  <path d="M12.5 9 C12.5 9 16 7 16 4.5 C16 2.5 14.5 1.5 13 2.5 C12.5 3 12.5 4 12.5 4" fill="none" stroke="#FFFEF5" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
              {%- elsif block.settings.thumbnail != blank -%}
                {{
                  block.settings.thumbnail
                  | image_url: width: 80
                  | image_tag:
                    width: 40,
                    height: 40,
                    loading: 'lazy',
                    alt: block.settings.title,
                    class: 'hero-offer__product-thumb'
                }}
              {%- endif -%}
            </div>
            <div class="hero-offer__product-info">
              <div class="hero-offer__product-header">
                {%- if block.settings.title != blank -%}
                  <span class="hero-offer__product-title">{{ block.settings.title }}</span>
                {%- endif -%}
                {%- assign has_tags = false -%}
                {%- if block.settings.flavor != blank or block.settings.count != blank -%}
                  {%- assign has_tags = true -%}
                {%- endif -%}
                {%- if has_tags -%}
                  <div class="hero-offer__product-tags">
                    {%- if block.settings.flavor != blank -%}
                      <span class="hero-offer__tag">{{ block.settings.flavor }}</span>
                    {%- endif -%}
                    {%- if block.settings.count != blank -%}
                      <span class="hero-offer__tag">{{ block.settings.count }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              {%- if block.settings.description != blank -%}
                <span class="hero-offer__product-description">{{ block.settings.description }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      </div>

      {%- comment -%} Benefits container: secondary badges + CTA + shipping {%- endcomment -%}
      <div class="hero-offer__benefits-container">

        {%- comment -%} Secondary benefit badges {%- endcomment -%}
        <div class="hero-offer__secondary-benefits">
          {%- assign badge_ids = 'benefit_badge_1,benefit_badge_2,benefit_badge_3,benefit_badge_4' | split: ',' -%}
          {%- for badge_id in badge_ids -%}
            {%- assign badge_val = section.settings[badge_id] -%}
            {%- if badge_val != blank -%}
              <span class="hero-offer__badge-item">
                <span class="hero-offer__small-check" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2 5l2 2 4-4" fill="none" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="hero-offer__badge-text">{{ badge_val }}</span>
                {%- if badge_id == 'benefit_badge_4' -%}
                  <span class="hero-offer__info-icon" aria-label="More information">
                    <svg width="10" height="10" viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <circle cx="5" cy="5" r="4" fill="none" stroke="#000000" stroke-width="1"/>
                      <line x1="5" y1="4.5" x2="5" y2="7" stroke="#000000" stroke-width="1.2" stroke-linecap="round"/>
                      <circle cx="5" cy="3" r="0.6" fill="#000000"/>
                    </svg>
                  </span>
                {%- endif -%}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} CTA Button {%- endcomment -%}
        <a
          class="hero-offer__cta-button"
          {% if section.settings.button_url != blank %}href="{{ section.settings.button_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
        >
          <span class="hero-offer__cta-label">{{ section.settings.button_label | default: 'ADD TO CART' }}</span>
          <div class="hero-offer__cta-price">
            {%- if section.settings.original_price != blank -%}
              <span class="hero-offer__cta-price-original">{{ section.settings.original_price }}</span>
            {%- endif -%}
            {%- if section.settings.current_price != blank -%}
              <span class="hero-offer__cta-price-current">{{ section.settings.current_price }}</span>
            {%- endif -%}
          </div>
        </a>

        {%- comment -%} Shipping info row {%- endcomment -%}
        <div class="hero-offer__shipping-row">
          <span class="hero-offer__shipping-item">
            <span class="hero-offer__shipping-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                <rect x="1" y="5" width="11" height="9" rx="1" fill="none" stroke="#000000" stroke-width="1"/>
                <path d="M12 8h3l2 3v3h-5V8z" fill="none" stroke="#000000" stroke-width="1"/>
                <circle cx="4.5" cy="14.5" r="1.5" fill="none" stroke="#000000" stroke-width="1"/>
                <circle cx="13.5" cy="14.5" r="1.5" fill="none" stroke="#000000" stroke-width="1"/>
                <line x1="1" y1="5" x2="1" y2="3" stroke="#000000" stroke-width="1"/>
              </svg>
            </span>
            <span class="hero-offer__shipping-text">{{ section.settings.shipping_text | default: 'Delivered every month' }}</span>
          </span>
          <span class="hero-offer__shipping-item">
            <span class="hero-offer__shipping-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 2 L16 5 L16 10 C16 13.5 13 16.5 9 17.5 C5 16.5 2 13.5 2 10 L2 5 Z" fill="none" stroke="#000000" stroke-width="1"/>
                <path d="M6 9l2 2 4-4" fill="none" stroke="#000000" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="hero-offer__shipping-text">{{ section.settings.guarantee_text | default: '100 Days Money Back Guarantee' }}</span>
          </span>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var galleryId = 'hero-offer-gallery-{{ section.id }}';
  function initGallery() {
    var gallery = document.getElementById(galleryId);
    if (!gallery) return;
    var mainImg = gallery.querySelector('.hero-offer__main-img');
    if (!mainImg) return;
    var thumbs = gallery.querySelectorAll('.hero-offer__thumb');
    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        var src = this.getAttribute('data-src');
        var srcset = this.getAttribute('data-srcset');
        var alt = this.getAttribute('data-alt') || '';
        if (src) mainImg.src = src;
        if (srcset) mainImg.srcset = srcset;
        mainImg.alt = alt;
        thumbs.forEach(function(t) { t.classList.remove('hero-offer__thumb--active'); });
        this.classList.add('hero-offer__thumb--active');
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGallery);
  } else {
    initGallery();
  }
})();
</script>

{% stylesheet %}
  .hero-offer__inner {
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: #FDF0F2;
    border-radius: 12px;
    overflow: hidden;
  }

  .hero-offer__gallery {
    display: flex;
    flex-direction: column;
    width: 100%;
    flex-shrink: 0;
  }

  .hero-offer__image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .hero-offer__image-el {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-offer__image-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-offer__thumbs {
    display: flex;
    flex-direction: row;
    gap: 8px;
    padding: 10px 12px;
    background-color: #ffffff;
    border-top: 1px solid rgba(104, 0, 64, 0.1);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hero-offer__thumbs::-webkit-scrollbar {
    display: none;
  }

  .hero-offer__thumb {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 6px;
    border: 2px solid transparent;
    background: none;
    padding: 2px;
    cursor: pointer;
    overflow: hidden;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s ease;
  }

  .hero-offer__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 3px;
    display: block;
  }

  .hero-offer__thumb--active {
    border-color: #680040;
  }

  .hero-offer__thumb:hover:not(.hero-offer__thumb--active) {
    border-color: rgba(104, 0, 64, 0.4);
  }

  .hero-offer__content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px 16px 32px 16px;
  }

  .hero-offer__product-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero-offer__rating {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
  }

  .hero-offer__star {
    flex-shrink: 0;
  }

  .hero-offer__review-count {
    font-family: 'Roboto', sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 18px;
    color: #680040;
    margin-inline-start: 2px;
  }

  .hero-offer__heading {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;
    color: #680040;
    margin: 0;
  }

  .hero-offer__price-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
  }

  .hero-offer__price-current {
    font-family: 'Roboto', sans-serif;
    font-weight: 500;
    font-size: 18px;
    line-height: 24px;
    color: #680040;
  }

  .hero-offer__price-original {
    font-family: sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 24px;
    color: #4B413A;
    text-decoration: line-through;
  }

  .hero-offer__benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero-offer__benefit-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .hero-offer__check-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
  }

  .hero-offer__benefit-text {
    font-family: sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 18px;
    color: #000000;
  }

  .hero-offer__product-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .hero-offer__product-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 12px;
    padding-block: 12px;
  }

  .hero-offer__product-row:not(:last-child) {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .hero-offer__product-icon {
    flex-shrink: 0;
    width: 48px;
