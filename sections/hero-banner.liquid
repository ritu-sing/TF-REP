    {
      "name": "Hero Banner",
      "blocks": [
        {
          "type": "trust-badge",
          "settings": {
            "label": "Parent Owned"
          }
        },
        {
          "type": "trust-badge",
          "settings": {
            "label": "3rd Party Tested"
          }
        },
        {
          "type": "trust-badge",
          "settings": {
            "label": "Allergen Free"
          }
        },
        {
          "type": "trust-badge",
          "settings": {
            "label": "USDA Organic"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
