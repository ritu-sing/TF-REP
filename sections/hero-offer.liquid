    color: #ffffff;
    text-transform: uppercase;
  }

  .hero-offer__shipping-row {
    display: flex;
    flex-direction: row;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-offer__shipping-item {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .hero-offer__shipping-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
  }

  .hero-offer__shipping-text {
    font-family: sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 18px;
    color: #000000;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .hero-offer__inner {
      flex-direction: row;
      gap: 8px;
      width: 100%;
      border: 1px solid rgba(104, 0, 64, 0.15);
    }

    .hero-offer__gallery {
      width: 46%;
      flex-shrink: 0;
    }

    .hero-offer__image-wrap {
      flex: 1;
      aspect-ratio: auto;
      min-height: 0;
    }

    .hero-offer__image-el {
      height: 100%;
      object-fit: cover;
    }

    .hero-offer__content {
      flex: 1;
      padding: 40px 40px 32px 40px;
    }

    .hero-offer__secondary-benefits {
      flex-wrap: nowrap;
    }
  }
{% endstylesheet %}

