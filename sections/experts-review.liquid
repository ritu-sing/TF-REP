{%- liquid
  assign slide_count = section.blocks.size
  assign show_arrows_val = section.settings.show_arrows
-%}

{%- capture slides -%}
  {%- for block in section.blocks -%}
    {%- capture card_content -%}
      <div class="experts-review__card experts-review__card--info-{{ section.settings.info_position }}" {{ block.shopify_attributes }}>
        {%- if block.settings.expert_image != blank -%}
          <div class="experts-review__image-wrapper">
            {{
              block.settings.expert_image
              | image_url: width: 240
              | image_tag:
                class: 'experts-review__image',
                loading: 'lazy',
                alt: block.settings.expert_name,
                width: section.settings.photo_size,
                height: section.settings.photo_size
            }}
          </div>
        {%- endif -%}

        {%- if section.settings.info_position == 'top' -%}
          <div class="experts-review__expert-info">
            {%- if block.settings.expert_name != blank -%}
              <span class="experts-review__expert-name">{{ block.settings.expert_name | escape }}</span>
            {%- endif -%}
            {%- if block.settings.expert_title != blank -%}
              <span class="experts-review__expert-title">{{ block.settings.expert_title | escape }}</span>
            {%- endif -%}
            {%- if block.settings.expert_organization != blank -%}
              <span class="experts-review__expert-organization">{{ block.settings.expert_organization | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <p class="experts-review__text">{{ block.settings.review_text | escape }}</p>

        {%- if section.settings.info_position == 'bottom' -%}
          <div class="experts-review__expert-info">
            {%- if block.settings.expert_name != blank -%}
              <span class="experts-review__expert-name">{{ block.settings.expert_name | escape }}</span>
            {%- endif -%}
            {%- if block.settings.expert_title != blank -%}
              <span class="experts-review__expert-title">{{ block.settings.expert_title | escape }}</span>
            {%- endif -%}
            {%- if block.settings.expert_organization != blank -%}
              <span class="experts-review__expert-organization">{{ block.settings.expert_organization | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endcapture -%}
    {%- render 'slideshow-slide',
      index: forloop.index0,
      children: card_content,
      class: 'experts-review__slide'
    -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture controls -%}
  {%- render 'slideshow-controls',
    style: 'dots',
    item_count: slide_count,
    show_arrows: show_arrows_val,
    icon_style: section.settings.icons_style,
    shape: section.settings.icons_shape
  -%}
{%- endcapture -%}

{%- capture slideshow_style -%}
  --experts-review-columns: {{ section.settings.columns }};
  {%- render 'gap-style', value: section.settings.gap, name: 'experts-review-gap' -%}
{%- endcapture -%}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_bg_color }};
    --experts-review-photo-size: {{ section.settings.photo_size }}px;
    --experts-review-expert-name-color: {{ section.settings.expert_name_color }};
    --experts-review-subheading-color: {{ section.settings.subheading_color }};
    --experts-review-card-bg: {{ section.settings.card_bg_color }};
    --experts-review-card-border-color: {{ section.settings.card_border_color }};
    --experts-review-card-border-radius: {{ section.settings.card_border_radius }}px;
    --experts-review-review-text-color: {{ section.settings.review_text_color }};
    --experts-review-expert-title-color: {{ section.settings.expert_title_color }};
    --experts-review-expert-org-color: {{ section.settings.expert_org_color }};
    --experts-review-photo-border-color: {{ section.settings.photo_border_color }};
    --experts-review-photo-border-width: {{ section.settings.photo_border_width }}px;
    --experts-review-watermark-color: {{ section.settings.watermark_color }};
    --experts-review-watermark-size: {{ section.settings.watermark_size }}px;
    --experts-review-heading-size: {{ section.settings.heading_size }}px;
    --experts-review-subheading-size: {{ section.settings.subheading_size }}px;
    --experts-review-review-text-size: {{ section.settings.review_text_size }}px;
    --experts-review-expert-name-size: {{ section.settings.expert_name_size }}px;
    --experts-review-watermark-opacity: {{ section.settings.watermark_opacity | divided_by: 100.0 }};
    --experts-review-wm1-x: {{ section.settings.watermark_1_x }}%;
    --experts-review-wm1-y: {{ section.settings.watermark_1_y }}%;
    --experts-review-wm2-x: {{ section.settings.watermark_2_x }}%;
    --experts-review-wm2-y: {{ section.settings.watermark_2_y }}%;
    --experts-review-wm1-x-mob: {{ section.settings.watermark_1_x_mobile }}%;
    --experts-review-wm1-y-mob: {{ section.settings.watermark_1_y_mobile }}%;
    --experts-review-wm2-x-mob: {{ section.settings.watermark_2_x_mobile }}%;
    --experts-review-wm2-y-mob: {{ section.settings.watermark_2_y_mobile }}%;
    --experts-review-watermark-z: {% if section.settings.watermark_layer == 'front' %}3{% else %}0{% endif %};
    --section-heading-font: var(--font-{{ section.settings.heading_font }}--family);
    --section-body-font: var(--font-{{ section.settings.body_font }}--family);
    {%- if section.settings.heading_weight != blank %}
    --section-heading-weight: {{ section.settings.heading_weight }};
    {%- endif %}
    {%- if section.settings.body_weight != blank %}
    --section-body-weight: {{ section.settings.body_weight }};
    {%- endif %}
  }
  #shopify-section-{{ section.id }} > .section {
    position: relative;
  }
  #shopify-section-{{ section.id }} .experts-review__heading {
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .experts-review__subheading {
    color: {{ section.settings.subheading_color }};
  }
</style>

<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  {%- if section.settings.show_watermark -%}
    {%- capture wm_inner -%}
      {%- if section.settings.watermark_image != blank -%}
        {{
          section.settings.watermark_image
          | image_url: width: 300
          | image_tag:
            loading: 'lazy',
            class: 'experts-review__watermark-img',
            alt: ''
        }}
      {%- else -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="currentColor" role="presentation" aria-hidden="true">
          <path d="M50 5 C47 5 44 7 43 10 C42 13 43 17 46 19 L45 30 C43 34 41 38 40 43 L38 55 C36 60 34 65 32 72 L30 85 L36 85 L39 68 C41 63 42 60 43 56 L45 72 L48 87 L53 87 L50 72 L49 56 C51 53 55 53 57 56 L56 72 L53 87 L58 87 L61 72 L63 56 C64 60 65 63 67 68 L70 85 L76 85 L74 72 C72 65 70 60 68 55 L66 43 C65 38 63 34 61 30 L60 19 C63 17 64 13 63 10 C62 7 59 5 56 5 C54 4 52 4 50 5 Z"/>
        </svg>
      {%- endif -%}
    {%- endcapture -%}
    <div class="experts-review__watermarks" aria-hidden="true">
      <span class="experts-review__watermark experts-review__watermark--1">{{ wm_inner }}</span>
      <span class="experts-review__watermark experts-review__watermark--2">{{ wm_inner }}</span>
    </div>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <h2
      class="experts-review__heading"
      style="text-align: {{ section.settings.heading_alignment }};"
    >
      {{ section.settings.heading | escape }}
    </h2>
  {%- endif -%}

  {%- if section.settings.subheading != blank -%}
    <p
      class="experts-review__subheading"
      style="text-align: {{ section.settings.heading_alignment }};"
    >
      {{ section.settings.subheading | escape }}
    </p>
  {%- endif -%}

  {%- render 'slideshow',
    class: 'experts-review__slideshow',
    style: slideshow_style,
    slides: slides,
    slide_count: slide_count,
    show_arrows: show_arrows_val,
    auto_hide_controls: true,
    infinite: false,
    controls: controls
  -%}
</div>

{% stylesheet %}
  .experts-review__heading {
    margin: 0 0 var(--margin-3xl);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: var(--experts-review-heading-size, var(--font-h3--size));
    line-height: var(--font-h3--line-height);
    letter-spacing: var(--font-h3--letter-spacing);
    text-transform: var(--font-h3--case);
    color: var(--color-foreground-heading);
  }

  .experts-review__subheading {
    margin: calc(-1 * var(--margin-3xl) + var(--margin-lg)) 0 var(--margin-3xl);
    font-family: var(--font-body--family);
    font-size: var(--experts-review-subheading-size, var(--font-paragraph--size));
    line-height: var(--font-paragraph--line-height);
    color: var(--experts-review-subheading-color, rgb(var(--color-foreground-rgb) / 0.7));
  }

  .experts-review__slideshow slideshow-slides {
    --slideshow-gap: var(--experts-review-gap, 24px);
  }

  .experts-review__slideshow slideshow-container {
    background-color: transparent;
  }

  .experts-review__slide {
    flex: 0 0 auto;
    width: 85%;
    overflow: visible;
  }

  .experts-review__card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    padding: var(--padding-4xl);
    background-color: var(--experts-review-card-bg, var(--color-background));
    border: 1px solid var(--experts-review-card-border-color, var(--color-border));
    border-radius: var(--experts-review-card-border-radius, var(--style-border-radius-lg));
    height: 100%;
    position: relative;
    overflow: visible;
  }

  .experts-review__image-wrapper {
    width: var(--experts-review-photo-size, 96px);
    height: var(--experts-review-photo-size, 96px);
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: var(--experts-review-photo-border-width, 3px) solid var(--experts-review-photo-border-color, #ffffff);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
    align-self: center;
  }

  .experts-review__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .experts-review__text {
    font-family: var(--section-body-font, var(--font-body--family));
    font-size: var(--experts-review-review-text-size, var(--font-paragraph--size));
    line-height: var(--font-paragraph--line-height);
    letter-spacing: var(--font-paragraph--letter-spacing);
    color: var(--experts-review-review-text-color, var(--color-foreground));
    margin: 0;
    flex-grow: 1;
  }

  .experts-review__text::before {
    content: '\201C';
  }

  .experts-review__text::after {
    content: '\201D';
  }

  .experts-review__expert-info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .experts-review__card--info-bottom .experts-review__expert-info {
    padding-block-start: var(--padding-xs);
    border-top: 1px solid var(--experts-review-card-border-color, var(--color-border));
  }

  .experts-review__card--info-top .experts-review__expert-info {
    padding-block-end: var(--padding-xs);
    border-bottom: 1px solid var(--experts-review-card-border-color, var(--color-border));
    text-align: center;
  }

  .experts-review__expert-name {
    font-family: var(--section-body-font, var(--font-subheading--family));
    font-weight: var(--section-body-weight, 700);
    font-size: var(--experts-review-expert-name-size, var(--font-size--sm));
    line-height: var(--line-height--body-normal);
    color: var(--experts-review-expert-name-color, #9B1B6E);
  }

  .experts-review__expert-title {
    font-family: var(--section-body-font, var(--font-body--family));
    font-size: var(--font-size--xs);
    line-height: var(--line-height--body-normal);
    color: var(--experts-review-expert-title-color, rgb(var(--color-foreground-rgb) / 0.65));
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .experts-review__expert-organization {
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    line-height: var(--line-height--body-normal);
    color: var(--experts-review-expert-org-color, rgb(var(--color-foreground-rgb) / 0.55));
  }

  .experts-review__slideshow slideshow-controls:has(.slideshow-controls__dots) {
    mix-blend-mode: normal;
  }

  .experts-review__watermarks {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: var(--experts-review-watermark-z, 3);
    overflow: hidden;
  }

  .experts-review__watermark {
    position: absolute;
    color: var(--experts-review-watermark-color, white);
    width: var(--experts-review-watermark-size, 160px);
    height: var(--experts-review-watermark-size, 160px);
    opacity: var(--experts-review-watermark-opacity, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .experts-review__watermark svg,
  .experts-review__watermark-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .experts-review__watermark-img {
    filter: brightness(0) invert(1);
  }

  .experts-review__watermark--1 {
    left: var(--experts-review-wm1-x-mob, 50%);
    top: var(--experts-review-wm1-y-mob, 25%);
    transform: translate(-50%, -50%);
  }

  .experts-review__watermark--2 {
    left: var(--experts-review-wm2-x-mob, 50%);
    top: var(--experts-review-wm2-y-mob, 75%);
    transform: translate(-50%, -50%);
  }

  @media screen and (max-width: 749px) {
    .experts-review__slideshow slideshow-slides {
      display: grid;
      grid-template-columns: 1fr;
      overflow: visible;
      scroll-snap-type: none;
      row-gap: calc(var(--experts-review-photo-size, 96px) / 2 + 24px);
    }

    .experts-review__slide {
      width: 100%;
    }

    .experts-review__slideshow slideshow-controls {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .experts-review__slideshow {
      margin-block-start: calc(var(--experts-review-photo-size, 96px) / 2 + 16px);
    }

    .experts-review__slideshow slideshow-slides {
      overflow: visible;
    }

    .experts-review__slide {
      width: calc(
        (100% - (var(--experts-review-gap, 24px) * (var(--experts-review-columns, 3) - 1))) /
          var(--experts-review-columns, 3)
      );
    }

    .experts-review__slideshow slideshow-controls {
      display: none;
    }

    .experts-review__slideshow slideshow-arrows {
      display: none;
    }

    .experts-review__card {
      padding-block-start: calc(var(--experts-review-photo-size, 96px) / 2 + 24px);
      align-items: center;
    }

    .experts-review__image-wrapper {
      position: absolute;
      top: calc(-1 * var(--experts-review-photo-size, 96px) / 2);
      left: 50%;
      transform: translateX(-50%);
    }

    .experts-review__watermark--1 {
      left: var(--experts-review-wm1-x, 33%);
      top: var(--experts-review-wm1-y, 50%);
    }

    .experts-review__watermark--2 {
      left: var(--experts-review-wm2-x, 67%);
      top: var(--experts-review-wm2-y, 50%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Experts Review",
  "class": "experts-review",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Approved By The Experts"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Recommending what's best for you and your family"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "review_text_size",
      "label": "Review text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "expert_name_size",
      "label": "Expert name size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body / card text font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Body weight",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background",
      "default": "#9B1B6E"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "review_text_color",
      "label": "Review text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "expert_name_color",
      "label": "Expert name",
      "default": "#9B1B6E"
    },
    {
      "type": "color",
      "id": "expert_title_color",
      "label": "Expert title / credential",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "expert_org_color",
      "label": "Organization",
      "default": "#999999"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "info_position",
      "label": "Expert info position",
      "options": [
        { "value": "top", "label": "Top (above review text)" },
        { "value": "bottom", "label": "Bottom (below review text)" }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Expert photo"
    },
    {
      "type": "range",
      "id": "photo_size",
      "label": "Photo size",
      "min": 64,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "color",
      "id": "photo_border_color",
      "label": "Photo border color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "photo_border_width",
      "label": "Photo border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "header",
      "content": "Watermark"
    },
    {
      "type": "checkbox",
      "id": "show_watermark",
      "label": "Show watermark",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "watermark_image",
      "label": "Watermark image",
      "info": "Upload a custom image. Leave empty to use the default llama icon.",
      "visible_if": "{{ section.settings.show_watermark }}"
    },
    {
