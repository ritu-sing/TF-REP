<style>
  #shopify-section-{{ section.id }} {
    --comparison-table-llama-col-bg: {{ section.settings.llama_col_bg }};
    --comparison-table-llama-col-fg: {{ section.settings.llama_col_fg }};
    --comparison-table-check-color: {{ section.settings.check_icon_color }};
    --comparison-table-cross-color: {{ section.settings.cross_icon_color }};
    --comparison-table-cta-bg: {{ section.settings.cta_bg_color }};
    --comparison-table-cta-fg: {{ section.settings.cta_text_color }};
  }
  #shopify-section-{{ section.id }} .comparison-table__cta {
    border-radius: 50px;
    --button-background-color: var(--comparison-table-cta-bg);
    --button-color: var(--comparison-table-cta-fg);
    --button-border-color: var(--comparison-table-cta-bg);
  }
</style>

<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  <div class="comparison-table__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="comparison-table__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="comparison-table__wrapper">
      <table class="comparison-table__table">
        <thead>
          <tr class="comparison-table__header-row">
            <th class="comparison-table__th comparison-table__th--feature" scope="col"></th>
            <th class="comparison-table__th comparison-table__th--llama" scope="col">
              {{ section.settings.llama_col_label | escape }}
            </th>
            <th class="comparison-table__th comparison-table__th--competitor" scope="col">
              {{ section.settings.competitor_col_label | escape }}
            </th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <tr class="comparison-table__row" {{ block.shopify_attributes }}>
                <td class="comparison-table__cell comparison-table__cell--feature">
                  {{ block.settings.label | escape }}
                </td>
                <td class="comparison-table__cell comparison-table__cell--llama">
                  {%- if block.settings.llama_has -%}
                    <svg class="comparison-table__icon comparison-table__icon--check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6L9 17l-5-5"/>
                    </svg>
                  {%- else -%}
                    <svg class="comparison-table__icon comparison-table__icon--cross" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 6L6 18M6 6l12 12"/>
                    </svg>
                  {%- endif -%}
                </td>
                <td class="comparison-table__cell comparison-table__cell--competitor">
                  {%- if block.settings.competitor_has -%}
                    <svg class="comparison-table__icon comparison-table__icon--check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6L9 17l-5-5"/>
                    </svg>
                  {%- else -%}
                    <svg class="comparison-table__icon comparison-table__icon--cross" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 6L6 18M6 6l12 12"/>
                    </svg>
                  {%- endif -%}
                </td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.show_cta and section.settings.cta_text != blank -%}
      <div class="comparison-table__cta-wrapper">
        <a
          href="{{ section.settings.cta_url }}"
          class="comparison-table__cta button"
        >
          {{ section.settings.cta_text | escape }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  /* ── Inner container ── */
  .comparison-table__inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  /* ── Heading ── */
  .comparison-table__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: var(--font-h2--size);
    line-height: var(--font-h2--line-height);
    letter-spacing: var(--font-h2--letter-spacing);
    text-transform: var(--font-h2--case);
    color: var(--color-foreground-heading);
    text-align: center;
  }

  /* ── Scrollable wrapper — mobile horizontal scroll ── */
  .comparison-table__wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 12px;
    border: 1px solid var(--color-border);
  }

  /* ── Table ── */
  .comparison-table__table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    table-layout: fixed;
  }

  /* ── Header cells ── */
  .comparison-table__th {
    padding: 16px 20px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-foreground-heading);
    border-bottom: 1px solid var(--color-border);
    text-align: center;
    vertical-align: middle;
  }

  .comparison-table__th--feature {
    text-align: start;
    width: 50%;
  }

  .comparison-table__th--llama {
    background-color: var(--comparison-table-llama-col-bg);
    color: var(--comparison-table-llama-col-fg);
    width: 25%;
  }

  .comparison-table__th--competitor {
    width: 25%;
  }

  /* ── Body rows ── */
  .comparison-table__row {
    border-bottom: 1px solid var(--color-border);
  }

  .comparison-table__row:last-child {
    border-bottom: none;
  }

  /* ── Body cells ── */
  .comparison-table__cell {
    padding: 14px 20px;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-foreground);
    text-align: center;
    vertical-align: middle;
  }

  .comparison-table__cell--feature {
    text-align: start;
    font-weight: 500;
  }

  .comparison-table__cell--llama {
    background-color: var(--comparison-table-llama-col-bg);
    color: var(--comparison-table-llama-col-fg);
  }

  /* ── Icons — defaults (used in competitor column) ── */
  .comparison-table__icon--check {
    stroke: var(--comparison-table-check-color);
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }

  .comparison-table__icon--cross {
    stroke: var(--comparison-table-cross-color);
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }

  /* ── Icons — llama column override (icons on dark bg use fg color) ── */
  .comparison-table__cell--llama .comparison-table__icon {
    stroke: var(--comparison-table-llama-col-fg);
  }

  /* ── CTA wrapper ── */
  .comparison-table__cta-wrapper {
    display: flex;
    justify-content: center;
    padding-block-start: 8px;
  }

  /* ── CTA button — pill shape ── */
  .comparison-table__cta {
    border-radius: 50px;
    min-width: 180px;
    text-align: center;
  }

  /* ── Responsive ── */
  @media screen and (min-width: 750px) {
    .comparison-table__inner {
      gap: 48px;
    }

    .comparison-table__heading {
      font-size: var(--font-h1--size);
    }

    .comparison-table__th {
      padding: 20px 32px;
      font-size: 0.875rem;
    }

    .comparison-table__cell {
      padding: 18px 32px;
      font-size: 1rem;
    }

    .comparison-table__icon--check,
    .comparison-table__icon--cross {
      width: 24px;
      height: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Comparison table",
  "class": "comparison-table",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Llama Naturals?"
    },
    {
      "type": "header",
      "content": "Column labels"
    },
    {
      "type": "text",
      "id": "llama_col_label",
      "label": "Brand column label",
      "default": "Llama Naturals"
    },
    {
      "type": "text",
      "id": "competitor_col_label",
      "label": "Competitor column label",
      "default": "Other Brands"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "llama_col_bg",
      "label": "Brand column background",
      "default": "#3d1534"
    },
    {
      "type": "color",
      "id": "llama_col_fg",
      "label": "Brand column text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "check_icon_color",
      "label": "Check icon color",
      "default": "#3d1534"
    },
    {
      "type": "color",
      "id": "cross_icon_color",
      "label": "Cross icon color",
      "default": "#b0b0b0"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA background color",
      "default": "#3d1534"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-7"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Feature label",
          "default": "Feature"
        },
        {
          "type": "checkbox",
          "id": "llama_has",
          "label": "Llama Naturals has this",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "competitor_has",
          "label": "Competitors have this",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Real fruit ingredients",
            "llama_has": true,
            "competitor_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "No added cane sugar",
            "llama_has": true,
            "competitor_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "USDA Organic Certified",
            "llama_has": true,
            "competitor_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Third-party lab tested",
            "llama_has": true,
            "competitor_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Allergen free formula",
            "llama_has": true,
            "competitor_has": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "100-day money back guarantee",
            "llama_has": true,
            "competitor_has": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
