{% style %}
  #shopify-section-{{ section.id }} {
    --padding-block-start: {{ section.settings['padding-block-start'] }}px;
    --padding-block-end: {{ section.settings['padding-block-end'] }}px;
    --ln-tl-accent: {{ section.settings.accent_color }};
    --ln-tl-connector: {{ section.settings.connector_color }};
    --ln-tl-cta-bg: {{ section.settings.cta_bg_color }};
    --ln-tl-cta-text: {{ section.settings.cta_text_color }};
    --ln-tl-heading-font: var(--font-{{ section.settings.heading_font }}--family, inherit);
    --ln-tl-heading-size: {{ section.settings.heading_size }}px;
    --ln-tl-heading-weight: {{ section.settings.heading_weight }};
    --ln-tl-body-font: var(--font-{{ section.settings.body_font }}--family, inherit);
    --ln-tl-body-size: {{ section.settings.body_size }}px;
    --ln-tl-item-heading-size: {{ section.settings.item_heading_size | default: 16 }}px;
    --ln-tl-period-size: {{ section.settings.period_label_size }}px;
    {% if section.settings.heading_color != blank %}--ln-tl-heading-color: {{ section.settings.heading_color }};{% endif %}
    {% if section.settings.subheading_color != blank %}--ln-tl-subheading-color: {{ section.settings.subheading_color }};{% endif %}
    {% if section.settings.body_color != blank %}--ln-tl-body-color: {{ section.settings.body_color }};{% endif %}
    {% if section.settings.period_label_color != blank %}--ln-tl-period-color: {{ section.settings.period_label_color }};{% endif %}
    {% if section.settings.icon_bg_color != blank %}--ln-tl-icon-bg: {{ section.settings.icon_bg_color }};{% endif %}
    {% if section.settings.image_col_bg_color != blank %}--ln-tl-img-col-bg: {{ section.settings.image_col_bg_color }};{% endif %}
  }
{% endstyle %}

<ln-timeline class="ln-timeline color-{{ section.settings.color_scheme }} ln-timeline--{{ section.settings.section_width }}">
  <div class="ln-timeline__inner">

    {%- comment -%}Desktop: left column image — background-image fills reliably regardless of height context{%- endcomment -%}
    <div class="ln-timeline__image-col"
      {% if section.settings.image != blank %}
        style="background-image: url('{{ section.settings.image | image_url: width: 1200 }}')"
      {% endif %}
      {% if section.settings.image != blank %}
        role="img"
        aria-label="{{ section.settings.heading | strip_html }}"
      {% endif %}
    ></div>

    {%- comment -%}Right column: header + mobile image + items + footnote{%- endcomment -%}
    <div class="ln-timeline__content-col">

      <div class="ln-timeline__header">
        {% if section.settings.heading != blank %}
          <h2 class="ln-timeline__heading">{{ section.settings.heading | strip_html }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="ln-timeline__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      {%- comment -%}Mobile only: image appears between header and timeline items{%- endcomment -%}
      {% if section.settings.image != blank %}
        <div class="ln-timeline__image-mobile" aria-hidden="true">
          {{ section.settings.image | image_url: width: 800 | image_tag:
            widths: '400, 600, 800',
            loading: 'lazy',
            class: 'ln-timeline__image-mobile__img',
            alt: ''
          }}
        </div>
      {% endif %}

      <div class="ln-timeline__track" ref="track">
        {% for block in section.blocks %}
          <div class="ln-timeline__item" {{ block.shopify_attributes }}>
            <div class="ln-timeline__item-marker-col">
              <div class="ln-timeline__icon-wrap">
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon | image_url: width: 64 | image_tag:
                    widths: '32, 64',
                    loading: 'lazy',
                    alt: ''
                  }}
                {% endif %}
              </div>
              {% unless forloop.last %}
                <div class="ln-timeline__connector-line"></div>
              {% endunless %}
            </div>
            <div class="ln-timeline__item-body">
              {% if block.settings.period_label != blank %}
                <p class="ln-timeline__item-period">{{ block.settings.period_label }}</p>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h3 class="ln-timeline__item-heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="ln-timeline__item-desc">{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.footnote != blank %}
        <p class="ln-timeline__footnote">{{ section.settings.footnote }}</p>
      {% endif %}

      {% if section.settings.cta_text != blank and section.settings.cta_url != blank %}
        <div class="ln-timeline__cta">
          <a href="{{ section.settings.cta_url }}" class="ln-timeline__cta-btn">{{ section.settings.cta_text }}</a>
        </div>
      {% endif %}

    </div>

  </div>
</ln-timeline>

<script src="{{ 'ln-results-timeline.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  ln-timeline {
    display: block;
    overflow: hidden;
  }

  /* ── Inner 2-col grid ── */
  .ln-timeline__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }

  .ln-timeline--page-width .ln-timeline__inner {
    max-width: var(--page-content-width, 1280px);
    margin-inline: auto;
  }

  /* ── Image column (desktop left) ── */
  /* background-image fills reliably — no img height-resolution issues */
  .ln-timeline__image-col {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: var(--ln-tl-img-col-bg, #f0e8e0);
    min-height: 500px;
  }

  /* Mobile image: hidden on desktop */
  .ln-timeline__image-mobile {
    display: none;
  }

  /* ── Content column (desktop right) ── */
  .ln-timeline__content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    padding-block-start: var(--padding-block-start, 60px);
    padding-block-end: var(--padding-block-end, 60px);
    padding-inline-start: 52px;
    padding-inline-end: 40px;
  }

  /* ── Section heading / subheading ── */
  .ln-timeline__heading {
    margin: 0 0 10px;
    font-family: var(--ln-tl-heading-font, var(--font-heading--family, inherit));
    font-size: var(--ln-tl-heading-size, 2.25rem);
    font-weight: var(--ln-tl-heading-weight, 700);
    line-height: 1.15;
    color: var(--ln-tl-heading-color, var(--color-foreground));
  }

  .ln-timeline__subheading {
    margin: 0;
    font-family: var(--ln-tl-body-font, var(--font-body--family, inherit));
    font-size: var(--ln-tl-body-size, 1rem);
    line-height: 1.55;
    color: var(--ln-tl-subheading-color, var(--color-foreground));
    opacity: 0.75;
  }

  /* ── Track: vertical list of items ── */
  .ln-timeline__track {
    display: flex;
    flex-direction: column;
  }

  /* ── Single timeline item ── */
  .ln-timeline__item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  /* ── Left column: circle icon + connector ── */
  .ln-timeline__item-marker-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 48px;
  }

  .ln-timeline__icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid var(--ln-tl-accent, #680040);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    background-color: var(--ln-tl-icon-bg, transparent);
  }

  .ln-timeline__icon-wrap img {
    width: 26px;
    height: 26px;
    object-fit: contain;
  }

  .ln-timeline__connector-line {
    width: 1.5px;
    flex: 1;
    min-height: 20px;
    background-color: var(--ln-tl-connector, #d0c5b5);
    margin-block: 6px;
  }

  /* ── Item text body ── */
  .ln-timeline__item-body {
    flex: 1;
    padding-block-start: 10px;
    padding-block-end: 24px;
  }

  .ln-timeline__item:last-child .ln-timeline__item-body {
    padding-block-end: 0;
  }

  .ln-timeline__item-period {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    font-family: var(--ln-tl-heading-font, var(--font-heading--family, inherit));
    font-size: var(--ln-tl-period-size, 11px);
    color: var(--ln-tl-period-color, var(--ln-tl-accent, #680040));
    margin: 0 0 4px;
    line-height: 1.2;
  }

  .ln-timeline__item-heading {
    margin: 0 0 6px;
    font-family: var(--ln-tl-heading-font, var(--font-heading--family, inherit));
    font-size: var(--ln-tl-item-heading-size, 1rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ln-tl-heading-color, var(--color-foreground));
  }

  .ln-timeline__item-desc {
    margin: 0;
    font-family: var(--ln-tl-body-font, var(--font-body--family, inherit));
    font-size: var(--ln-tl-body-size, 1rem);
    line-height: 1.55;
    color: var(--ln-tl-body-color, var(--color-foreground));
    opacity: 0.8;
  }

  /* ── Footnote ── */
  .ln-timeline__footnote {
    margin: 0;
    font-family: var(--ln-tl-body-font, var(--font-body--family, inherit));
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ln-tl-body-color, var(--color-foreground));
    opacity: 0.55;
  }

  /* ── CTA ── */
  .ln-timeline__cta-btn {
    display: inline-block;
    padding: 14px 32px;
    background-color: var(--ln-tl-cta-bg, #680040);
    color: var(--ln-tl-cta-text, #ffffff);
    text-decoration: none;
    border-radius: 84px;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.03em;
    transition: opacity 0.2s ease;
  }

  .ln-timeline__cta-btn:hover {
    opacity: 0.9;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {
    .ln-timeline__inner {
      grid-template-columns: 1fr;
    }

    /* Hide desktop image column */
    .ln-timeline__image-col {
      display: none;
    }

    /* Show mobile image between header and items */
    .ln-timeline__image-mobile {
      display: block;
    }

    .ln-timeline__image-mobile__img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      display: block;
    }

    .ln-timeline__content-col {
      padding-inline-start: 20px;
      padding-inline-end: 20px;
      gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Results timeline",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (left column)"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Results Timeline</p>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "What to expect and when you will begin noticing results"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote text"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Section heading size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "100", "label": "100" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "body"
    },
    {
      "type": "range",
      "id": "item_heading_size",
      "label": "Item heading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Description text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / icon border color",
      "default": "#680040"
    },
    {
      "type": "color",
      "id": "connector_color",
      "label": "Connector line color",
      "default": "#d0c5b5"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA background",
      "default": "#680040"
    },
    {
      "type": "color",
