          "default": "Feel the difference"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Results timeline",
      "blocks": [
        {
          "type": "timeline-item",
          "settings": {
            "period_label": "WEEK 1-2",
            "heading": "The Fight Is Over",
            "description": "Kids ask for their gummy before you even remember. No bribing. No battles."
          }
        },
        {
          "type": "timeline-item",
          "settings": {
            "period_label": "Week 2-4",
